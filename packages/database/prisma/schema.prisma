  ruleLookbackDays        Int      @default(7) @map("rule_lookback_days")
  ruleCooldownMinutes     Int      @default(60) @map("rule_cooldown_minutes")
  minSpendForAction       Decimal? @map("min_spend_for_action") @db.Decimal(14, 2)
  emergencyStop           Boolean  @default(false) @map("emergency_stop")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("ad_manager_settings")
}

model AdAutomationRule {
