model AuthToken {
  id        String        @id @default(uuid())
  userId    String        @map("user_id")
  type      AuthTokenType
  tokenHash String        @unique @map("token_hash")
  expiresAt DateTime      @map("expires_at")
  usedAt    DateTime?     @map("used_at")
  createdAt DateTime      @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([expiresAt])
  @@map("auth_tokens")
}

model LoginAttempt {
  id        String   @id @default(uuid())
  email     String
  ipAddress String?  @map("ip_address")
  success   Boolean
  createdAt DateTime @default(now()) @map("created_at")

  @@index([email, createdAt])
  @@index([ipAddress, createdAt])
  @@map("login_attempts")
}

/// OTP đăng ký — chưa tạo User; chỉ lưu hash OTP + passwordHash
model RegistrationOtp {
  id                 String    @id @default(uuid())
  email              String
  codeHash           String    @map("code_hash")
  passwordHash       String    @map("password_hash")
  name               String
  organizationName   String    @map("organization_name")
  organizationSlug   String?   @map("organization_slug")
  /// Mã ref từ cookie lúc send-otp (server-side lock)
  referralCode       String?   @map("referral_code")
  expiresAt          DateTime  @map("expires_at")
  attemptCount       Int       @default(0) @map("attempt_count")
  maxAttempts        Int       @default(5) @map("max_attempts")
  consumedAt         DateTime? @map("consumed_at")
  invalidatedAt      DateTime? @map("invalidated_at")
  ipAddress          String?   @map("ip_address")
  createdAt          DateTime  @default(now()) @map("created_at")

  @@index([email, createdAt])
  @@index([expiresAt])
  @@map("registration_otps")
}

model SubscriptionPlan {
  id              String   @id @default(uuid())
  code            String   @unique
  name            String
  /// Giữ tương thích seed cũ (giá / tháng quy đổi)
  priceMonthly    Decimal  @map("price_monthly") @db.Decimal(12, 2)
  /// Giá thanh toán theo chu kỳ (VND)
  priceVnd        Decimal  @default(0) @map("price_vnd") @db.Decimal(14, 0)
  /// Số tháng gia hạn khi thanh toán
  durationMonths  Int      @default(1) @map("duration_months")
  highlightLabel  String?  @map("highlight_label")
  savingsAmount   Decimal? @map("savings_amount") @db.Decimal(14, 0)
  sortOrder       Int      @default(0) @map("sort_order")
  creditsIncluded Int      @default(0) @map("credits_included")
  features        Json     @default("[]")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")

  subscriptions Subscription[]
  paymentOrders PaymentOrder[]

  @@map("subscription_plans")
}

model Subscription {
  id                 String             @id @default(uuid())
  organizationId     String             @map("organization_id")
  planId             String             @map("plan_id")
  status             SubscriptionStatus @default(EXPIRED)
  currentPeriodStart DateTime           @map("current_period_start")
  currentPeriodEnd   DateTime           @map("current_period_end")
  /// Thời điểm user bấm kích hoạt dùng thử (không tính từ lúc đăng ký)
  trialStartedAt     DateTime?          @map("trial_started_at")
  trialEndsAt        DateTime?          @map("trial_ends_at")
  cancelledAt        DateTime?          @map("cancelled_at")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         SubscriptionPlan @relation(fields: [planId], references: [id])
  trialClaim   TrialClaim?

  @@index([organizationId, status])
  @@index([status, trialEndsAt])
  @@map("subscriptions")
}

/// Cấu hình dùng thử (singleton id=default)
model TrialSetting {
  id                      String   @id @default("default")
  enabled                 Boolean  @default(true)
  trialDays               Int      @default(3) @map("trial_days")
  /// Prefix API được phép khi TRIALING, VD: ["content-marketing","auto-post","video-transcriptions"]
  allowedFeaturePrefixes  Json     @default("[\"content-marketing\",\"auto-post\",\"video-transcriptions\"]") @map("allowed_feature_prefixes")
  aiDailyQuota            Int      @default(30) @map("ai_daily_quota")
  updatedAt               DateTime @updatedAt @map("updated_at")

  @@map("trial_settings")
}

/// Mỗi email/org/user/device chỉ được trial 1 lần (chống lạm dụng)
model TrialClaim {
  id                     String   @id @default(uuid())
  userId                 String   @unique @map("user_id")
  organizationId         String   @unique @map("organization_id")
  subscriptionId         String?  @unique @map("subscription_id")
  emailNormalized        String   @unique @map("email_normalized")
  phoneNormalized        String?  @map("phone_normalized")
  deviceFingerprintHash  String?  @map("device_fingerprint_hash")
  ipHash                 String?  @map("ip_hash")
  activatedAt            DateTime @map("activated_at")
  trialEndsAt            DateTime @map("trial_ends_at")
  createdAt              DateTime @default(now()) @map("created_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([phoneNormalized])
  @@index([deviceFingerprintHash])
  @@map("trial_claims")
}

/// Đơn thanh toán SaaS (SePay / VietQR)
model PaymentOrder {
