  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  funnel       FunnelRecommendation @relation(fields: [funnelId], references: [id], onDelete: Cascade)
  mqlStage     FunnelStage?         @relation("ScoringMqlStage", fields: [mqlStageId], references: [id], onDelete: SetNull)
  sqlStage     FunnelStage?         @relation("ScoringSqlStage", fields: [sqlStageId], references: [id], onDelete: SetNull)
