model ChatbotConversation {
  id                String                    @id @default(uuid())
  organizationId    String                    @map("organization_id")
  botId             String                    @map("bot_id")
  sessionId         String                    @map("session_id")
  visitorName       String?                   @map("visitor_name")
  visitorPhone      String?                   @map("visitor_phone")
  /// Avatar Messenger (Graph profile_pic) — không lưu token
  visitorAvatarUrl  String?                   @map("visitor_avatar_url") @db.VarChar(2000)
  channel           String                    @default("website")
  externalUserId    String?                   @map("external_user_id")
  channelRef        String?                   @map("channel_ref")
  status            ChatbotConversationStatus @default(OPEN)
  /// Khi nhân viên tiếp quản — bot dừng trả lời
  humanTakeover     Boolean                   @default(false) @map("human_takeover")
  assignedEmployeeId String?                  @map("assigned_employee_id")
  linkedLeadId      String?                   @map("linked_lead_id")
  lastUserMessageAt DateTime?                 @map("last_user_message_at")
  /// Nhân viên đã đánh dấu đọc trong inbox (không gửi Meta)
  staffReadAt       DateTime?                 @map("staff_read_at")
  createdAt         DateTime                  @default(now()) @map("created_at")
  updatedAt         DateTime                  @updatedAt @map("updated_at")

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bot          ChatbotBot        @relation(fields: [botId], references: [id], onDelete: Cascade)
  messages     ChatbotMessage[]
  leads        ChatbotLead[]
  messagingIdentities MessagingContactIdentity[]

  @@unique([botId, sessionId])
  @@index([organizationId, updatedAt])
  @@index([organizationId, lastUserMessageAt])
  @@index([organizationId, channelRef, externalUserId])
  /// Inbox Project scope: org + bot + channel (+ channelRef/page/domain)
  @@index([organizationId, botId, updatedAt])
  @@index([organizationId, botId, channel, channelRef])
  @@map("chatbot_conversations")
}
model AssistantSession {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  userId         String    @map("user_id")
  title          String?   @db.VarChar(200)
  /// ACTIVE | ARCHIVED
  status         String    @default("ACTIVE") @db.VarChar(16)
  timezone       String    @default("Asia/Ho_Chi_Minh") @db.VarChar(64)
  lastMessageAt  DateTime? @map("last_message_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages     AssistantMessage[]
  auditLogs    AssistantAuditLog[]
  pendingActions AssistantPendingAction[]

  @@index([organizationId, userId, updatedAt])
  @@index([organizationId, status, updatedAt])
  @@map("assistant_sessions")
}
model AssistantMessage {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  sessionId      String   @map("session_id")
  userId         String   @map("user_id")
  /// USER | ASSISTANT | SYSTEM | TOOL
  role           String   @db.VarChar(16)
  /// Nội dung đã redact / mask; Tool: JSON truncated không chứa PII đầy đủ
  content        String   @db.Text
  toolName       String?  @map("tool_name") @db.VarChar(80)
  toolCallId     String?  @map("tool_call_id") @db.VarChar(80)
  /// Metadata an toàn (counts, codes) — không phone/email/token
  meta           Json?
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  session      AssistantSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@index([organizationId, sessionId, createdAt])
  @@map("assistant_messages")
}
model AssistantPendingAction {
  id               String    @id @default(uuid())
  organizationId   String    @map("organization_id")
  userId           String    @map("user_id")
  sessionId        String?   @map("session_id")
  requestId        String    @map("request_id") @db.VarChar(64)
  toolName         String    @map("tool_name") @db.VarChar(80)
  /// PROPOSED | CONFIRMED | CANCELLED | EXPIRED | FAILED
  status           String    @default("PROPOSED") @db.VarChar(16)
  /// sha256(confirmSecret) — secret only returned once to client, never in LLM free text if avoidable
  confirmSecretHash String   @map("confirm_secret_hash") @db.VarChar(64)
  /// Optional client idempotency for propose
  proposeIdempotencyKey String? @map("propose_idempotency_key") @db.VarChar(120)
  /// Execute idempotency (confirm-once)
  executeIdempotencyKey String? @map("execute_idempotency_key") @db.VarChar(120)
  /// Args JSON (server only — may include ids, no secrets/passwords)
  argsJson         Json      @map("args_json")
  /// Redacted preview for UI (action, target, changes, actor)
  previewJson      Json      @map("preview_json")
  expiresAt        DateTime  @map("expires_at")
  confirmedAt      DateTime? @map("confirmed_at")
  cancelledAt      DateTime? @map("cancelled_at")
  executedAt       DateTime? @map("executed_at")
  /// Safe result metadata after execute (ids only)
  resultMeta       Json?     @map("result_meta")
  errorCode        String?   @map("error_code") @db.VarChar(40)
  errorMessage     String?   @map("error_message") @db.VarChar(500)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  session      AssistantSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@unique([organizationId, userId, proposeIdempotencyKey])
  @@index([organizationId, userId, status, expiresAt])
  @@index([confirmSecretHash])
  @@index([sessionId, createdAt])
  @@map("assistant_pending_actions")
}
model AssistantAuditLog {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  userId         String   @map("user_id")
  sessionId      String?  @map("session_id")
  requestId      String   @map("request_id") @db.VarChar(64)
  toolName       String?  @map("tool_name") @db.VarChar(80)
  /// TOOL_INVOKE | SESSION_CREATE | CHAT | FORBIDDEN | ERROR
  action         String   @db.VarChar(40)
  ok             Boolean?
  errorCode      String?  @map("error_code") @db.VarChar(40)
  durationMs     Int?     @map("duration_ms")
  /// Non-PII only (tool name, counts, truncated keys)
  meta           Json?
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  session      AssistantSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([organizationId, userId, createdAt])
  @@index([requestId])
  @@index([sessionId, createdAt])
  @@map("assistant_audit_logs")
}





model ChatbotMessage {
  id             String   @id @default(uuid())
  conversationId String   @map("conversation_id")
  role           String
  message        String   @db.Text
  /// Messenger pipeline: RECEIVED → PROCESSING → SENT (or FAILED)
  status         String?  @map("status")
  /// INBOUND | OUTBOUND
  direction      String?  @map("direction") @db.VarChar(16)
  /// CUSTOMER | BOT | PAGE | STAFF | SYSTEM
  senderType     String?  @map("sender_type") @db.VarChar(16)
  /// Meta message mid / event id — durable webhook dedupe
  externalMessageId String? @map("external_message_id") @db.VarChar(128)
  /// Machine-readable error: MISSING_SCOPE | TOKEN_EXPIRED | OPENAI_ERROR | MESSENGER_SEND_FAILED | …
  errorCode      String?  @map("error_code") @db.VarChar(64)
  createdAt      DateTime @default(now()) @map("created_at")

  conversation ChatbotConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@unique([conversationId, externalMessageId])
  @@map("chatbot_messages")
}

