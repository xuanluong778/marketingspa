  recommendationId     String?  @map("recommendation_id")
  actionType           MarketingAutopilotOutcomeActionType @map("action_type")
  draftType            MarketingAutopilotDraftType? @map("draft_type")
  status               MarketingAutopilotOutcomeTrackStatus @default(OPEN)
  recommendationJson   Json     @default("{}") @map("recommendation_json")
  beforeMetricsJson    Json     @default("{}") @map("before_metrics_json")
  beforeSnapshotId     String?  @map("before_snapshot_id")
  baselineAt           DateTime @default(now()) @map("baseline_at")
  productName          String   @default("") @map("product_name")
  customerProfile      String   @default("") @map("customer_profile")
  targetArea           String   @default("") @map("target_area")
  primaryGoal          String   @default("") @map("primary_goal")
  channelsJson         Json     @default("[]") @map("channels_json")
  offerJson            Json     @default("{}") @map("offer_json")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation(fields: [createdById], references: [id], onDelete: Cascade)
  project      MarketingAutopilotProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  mission      MarketingMission? @relation(fields: [missionId], references: [id], onDelete: SetNull)
  analysis     MarketingAutopilotAnalysis? @relation(fields: [analysisId], references: [id], onDelete: SetNull)
  draftRun     MarketingAutopilotDraftRun? @relation(fields: [draftRunId], references: [id], onDelete: SetNull)
  draft        MarketingAutopilotDraft? @relation(fields: [draftId], references: [id], onDelete: SetNull)
