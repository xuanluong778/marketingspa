/// Đề xuất thay đổi quảng cáo (before/after) — chờ ads.manage phê duyệt.
/// Worker thực hiện khi được duyệt; provider write API chưa bật (dry-run / local verify).
model AdsActionRequest {
  id                String                 @id @default(uuid())
  organizationId    String                 @map("organization_id")
  requestedByUserId String                 @map("requested_by_user_id")
  approvedByUserId  String?                @map("approved_by_user_id")
  campaignId        String?                @map("campaign_id")
  draftId           String?                @map("draft_id")
  recommendationId  String?                @map("recommendation_id")
  platform          AdPlatform
  actionType        AdsActionType          @map("action_type")
  source            AdsActionSource        @default(HUMAN)
  status            AdsActionRequestStatus @default(PROPOSED)
  /// Snapshot trước thay đổi (public metrics / status) — không chứa token
  beforeState       Json                   @default("{}") @map("before_state")
  /// Trạng thái mong muốn sau khi áp dụng
  afterState        Json                   @default("{}") @map("after_state")
  /// Tham số action (budget mới, status…) — không chứa credential
  payload           Json                   @default("{}")
  evidence          Json                   @default("{}")
  result            Json?
  reason            String?                @db.Text
  rejectionReason   String?                @map("rejection_reason") @db.Text
  /// Giới hạn ngân sách áp dụng cho action (null = dùng settings org)
  budgetLimit       Decimal?               @map("budget_limit") @db.Decimal(18, 6)
  proposedBudget    Decimal?               @map("proposed_budget") @db.Decimal(18, 6)
  idempotencyKey    String                 @map("idempotency_key")
  bullJobId         String?                @map("bull_job_id")
  attemptCount      Int                    @default(0) @map("attempt_count")
  maxAttempts       Int                    @default(3) @map("max_attempts")
  lastError         String?                @map("last_error") @db.Text
  /// true nếu AI đề xuất — bắt buộc người duyệt khác người yêu cầu
  aiGenerated       Boolean                @default(false) @map("ai_generated")
  providerWriteEnabled Boolean             @default(false) @map("provider_write_enabled")
  proposedAt        DateTime               @default(now()) @map("proposed_at")
  submittedAt       DateTime?              @map("submitted_at")
  approvedAt        DateTime?              @map("approved_at")
  executedAt        DateTime?              @map("executed_at")
  verifiedAt        DateTime?              @map("verified_at")
  createdAt         DateTime               @default(now()) @map("created_at")
  updatedAt         DateTime               @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requestedBy  User         @relation("AdsActionRequestedBy", fields: [requestedByUserId], references: [id], onDelete: Cascade)
  approvedBy   User?        @relation("AdsActionApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)

  @@unique([idempotencyKey])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, campaignId])
  @@index([requestedByUserId])
  @@index([approvedByUserId])
  @@map("ads_action_requests")
}

