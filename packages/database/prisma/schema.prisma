  provider             IntegrationProvider
  status               IntegrationStatus   @default(DISCONNECTED)
  encryptedCredentials String?             @map("encrypted_credentials")
  metadata             Json                @default("{}")
  lastTestedAt         DateTime?           @map("last_tested_at")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  messagingIdentities MessagingContactIdentity[]
  messagingCampaigns MessagingCampaign[]

  @@unique([organizationId, provider])
  @@index([organizationId])
  @@map("integrations")
}

// =============================================================================
// Multi-channel messaging identity (Messenger, Zalo OA, …)
// =============================================================================

/// Khách đã nhắn qua kênh tích hợp — không gộp tự động theo tên
model MessagingContactIdentity {
  id                     String                    @id @default(uuid())
  organizationId         String                    @map("organization_id")
  customerId             String?                   @map("customer_id")
  leadId                 String?                   @map("lead_id")
  channel                MessageChannel
  integrationId          String?                   @map("integration_id")
  /// Phạm vi unique: `integration:{id}` hoặc `{channel}:{accountRef}` (vd messenger_page:123)
  integrationScopeKey    String                    @map("integration_scope_key")
  externalUserId         String                    @map("external_user_id")
  externalConversationId String?                   @map("external_conversation_id")
  displayName            String?                   @map("display_name")
  avatarUrl              String?                   @map("avatar_url")
  phoneRaw               String?                   @map("phone_raw")
  phoneNormalized        String?                   @map("phone_normalized")
  phoneVerifiedAt        DateTime?                 @map("phone_verified_at")
  followStatus           MessagingFollowStatus     @default(UNKNOWN) @map("follow_status")
  consentStatus          MessagingConsentStatus    @default(UNKNOWN) @map("consent_status")
  isBlocked              Boolean                   @default(false) @map("is_blocked")
  optedOut               Boolean                   @default(false) @map("opted_out")
  linkSource             MessagingIdentityLinkSource @default(UNLINKED) @map("link_source")
  lastInboundAt          DateTime?                 @map("last_inbound_at")
  lastOutboundAt         DateTime?                 @map("last_outbound_at")
  mergedIntoId           String?                   @map("merged_into_id")
  chatbotConversationId  String?                   @map("chatbot_conversation_id")
  metadata               Json                      @default("{}")
  createdAt              DateTime                  @default(now()) @map("created_at")
  updatedAt              DateTime                  @updatedAt @map("updated_at")

  organization        Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer            Customer?                 @relation(fields: [customerId], references: [id], onDelete: SetNull)
  lead                Lead?                     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  integration         Integration?              @relation(fields: [integrationId], references: [id], onDelete: SetNull)
  mergedInto          MessagingContactIdentity? @relation("MessagingIdentityMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedFrom          MessagingContactIdentity[] @relation("MessagingIdentityMerge")
  chatbotConversation ChatbotConversation?      @relation(fields: [chatbotConversationId], references: [id], onDelete: SetNull)
  primaryMergeLogs    MessagingIdentityMergeLog[] @relation("PrimaryMergeIdentity")
  campaignRecipients  MessagingCampaignRecipient[]

  @@unique([organizationId, integrationScopeKey, externalUserId])
  @@unique([organizationId, integrationId, externalUserId])
  @@index([organizationId, channel])
  @@index([organizationId, customerId])
  @@index([organizationId, leadId])
  @@index([organizationId, phoneNormalized])
  @@index([organizationId, lastInboundAt])
  @@index([organizationId, consentStatus, optedOut])
  @@index([organizationId, followStatus])
  @@index([organizationId, mergedIntoId])
  @@index([organizationId, displayName])
  @@index([integrationId])
  @@index([chatbotConversationId])
  @@map("messaging_contact_identities")
}

/// Audit gộp identity thủ công — hỗ trợ hoàn tác
model MessagingIdentityMergeLog {
  id                String    @id @default(uuid())
  organizationId    String    @map("organization_id")
  primaryIdentityId String    @map("primary_identity_id")
  mergedIdentityIds String[]  @map("merged_identity_ids")
  mergedByUserId    String?   @map("merged_by_user_id")
  snapshot          Json
  undoneAt          DateTime? @map("undone_at")
  undoneByUserId    String?   @map("undone_by_user_id")
  createdAt         DateTime  @default(now()) @map("created_at")

  organization    Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  primaryIdentity MessagingContactIdentity @relation("PrimaryMergeIdentity", fields: [primaryIdentityId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([primaryIdentityId])
  @@map("messaging_identity_merge_logs")
}

// =============================================================================
// Multi-channel connections (Messenger pages, Zalo OA) — Prompt 4
// =============================================================================

enum MessagingChannelAccountStatus {
  DISCONNECTED
  ACTIVE
  EXPIRED
  REAUTH_REQUIRED
  ERROR
  PAUSED
  /// Zalo OA auto-refresh thất bại (có thể retry)
  REFRESH_FAILED
}

enum MessagingProviderKind {
  MESSENGER
  ZALO_OA
  ZBS_TEMPLATE
}

/// Kết nối Fanpage / Zalo OA theo organization — hỗ trợ nhiều tài khoản mỗi kênh
model MessagingChannelConnection {
  id                   String                        @id @default(uuid())
  organizationId       String                        @map("organization_id")
  channel              MessageChannel
  providerKind         MessagingProviderKind         @map("provider_kind")
  accountRef           String                        @map("account_ref")
  displayName          String?                       @map("display_name")
  encryptedCredentials String?                       @map("encrypted_credentials")
  status               MessagingChannelAccountStatus @default(DISCONNECTED)
  permissions          Json                          @default("[]")
  tokenExpiresAt       DateTime?                     @map("token_expires_at")
  lastSyncedAt         DateTime?                     @map("last_synced_at")
  lastTestedAt         DateTime?                     @map("last_tested_at")
  webhookSubscribed    Boolean                       @default(false) @map("webhook_subscribed")
  isPaused             Boolean                       @default(false) @map("is_paused")
  metadata             Json                          @default("{}")
  createdAt            DateTime                      @default(now()) @map("created_at")
  updatedAt            DateTime                      @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  messagingCampaigns MessagingCampaign[]

  @@unique([organizationId, channel, accountRef])
  @@unique([channel, accountRef])
  @@index([organizationId, channel])
  @@index([organizationId, status])
  @@map("messaging_channel_connections")
}

/// Dedupe webhook events — chống replay/trùng
model MessagingWebhookEvent {
  id             String         @id @default(uuid())
  organizationId String         @map("organization_id")
  channel        MessageChannel
  eventKey       String         @map("event_key")
  receivedAt     DateTime       @default(now()) @map("received_at")
  processedAt    DateTime?      @map("processed_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([channel, eventKey])
  @@index([organizationId, receivedAt])
  @@map("messaging_webhook_events")
}

// =============================================================================
// Bulk messaging campaigns (Prompt 6)
// =============================================================================

enum MessagingCampaignStatus {
  DRAFT
  SCHEDULED
  PLANNING
  RUNNING
  PAUSED
  COMPLETED
  CANCELLED
  FAILED
}

enum MessagingCampaignKind {
  AUTOMATION
  BROADCAST
  TRANSACTIONAL
  TEMPLATE
}

enum MessagingCampaignRecipientStatus {
  PENDING
  QUEUED
  SENT
  DELIVERED
  READ
  REPLIED
  FAILED
  SKIPPED
  OPTED_OUT
}

enum MessagingSuppressionReason {
  BLOCKED
  OPTED_OUT
  MANUAL
  BOUNCE
}

model MessagingCampaign {
  id                   String                  @id @default(uuid())
  organizationId       String                  @map("organization_id")
  name                 String
  channel              MessageChannel
  campaignType         MessagingCampaignKind   @map("campaign_type")
  channelConnectionId  String?                 @map("channel_connection_id")
  integrationId        String?                 @map("integration_id")
  messageTemplateId    String?                 @map("message_template_id")
  status               MessagingCampaignStatus @default(DRAFT)
  segmentConfig        Json                    @default("{}") @map("segment_config")
  segmentSnapshot      Json?                   @map("segment_snapshot")
  variables            Json                    @default("{}")
  scheduledAt          DateTime?               @map("scheduled_at")
  timezone             String                  @default("Asia/Ho_Chi_Minh")
  totalRecipients      Int                     @default(0) @map("total_recipients")
  eligibleCount        Int                     @default(0) @map("eligible_count")
  excludedCount        Int                     @default(0) @map("excluded_count")
  queuedCount          Int                     @default(0) @map("queued_count")
  sentCount            Int                     @default(0) @map("sent_count")
  deliveredCount       Int                     @default(0) @map("delivered_count")
  readCount            Int                     @default(0) @map("read_count")
  repliedCount         Int                     @default(0) @map("replied_count")
  failedCount          Int                     @default(0) @map("failed_count")
  optOutCount          Int                     @default(0) @map("opt_out_count")
  estimatedCost        Decimal                 @default(0) @map("estimated_cost") @db.Decimal(14, 2)
  actualCost           Decimal                 @default(0) @map("actual_cost") @db.Decimal(14, 2)
  createdByUserId      String?                 @map("created_by_user_id")
  startedAt            DateTime?               @map("started_at")
  completedAt          DateTime?               @map("completed_at")
  cancelledAt          DateTime?               @map("cancelled_at")
  pausedAt             DateTime?               @map("paused_at")
  metadata             Json                    @default("{}")
  createdAt            DateTime                @default(now()) @map("created_at")
  updatedAt            DateTime                @updatedAt @map("updated_at")

  organization        Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  channelConnection   MessagingChannelConnection?  @relation(fields: [channelConnectionId], references: [id], onDelete: SetNull)
  integration         Integration?                 @relation(fields: [integrationId], references: [id], onDelete: SetNull)
  messageTemplate     MessageTemplate?             @relation(fields: [messageTemplateId], references: [id], onDelete: SetNull)
  createdBy           User?                        @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  recipients          MessagingCampaignRecipient[]

  @@index([organizationId, status])
  @@index([organizationId, channel])
  @@index([organizationId, scheduledAt])
  @@map("messaging_campaigns")
}

model MessagingCampaignRecipient {
  id                String                           @id @default(uuid())
  organizationId    String                           @map("organization_id")
  campaignId        String                           @map("campaign_id")
  identityId        String                           @map("identity_id")
  customerId        String?                          @map("customer_id")
  leadId            String?                          @map("lead_id")
  eligible          Boolean                          @default(false)
  exclusionReason   String?                          @map("exclusion_reason")
  providerMode      String?                          @map("provider_mode")
  renderedContent   String?                          @map("rendered_content") @db.Text
  idempotencyKey    String                           @map("idempotency_key")
  providerMessageId String?                          @map("provider_message_id")
  status            MessagingCampaignRecipientStatus @default(PENDING)
  attemptCount      Int                              @default(0) @map("attempt_count")
  lastError         String?                          @map("last_error")
  cost              Decimal                          @default(0) @db.Decimal(12, 2)
  queuedAt          DateTime?                        @map("queued_at")
  sentAt            DateTime?                        @map("sent_at")
  deliveredAt       DateTime?                        @map("delivered_at")
  readAt            DateTime?                        @map("read_at")
  repliedAt         DateTime?                        @map("replied_at")
  createdAt         DateTime                         @default(now()) @map("created_at")
  updatedAt         DateTime                         @updatedAt @map("updated_at")

  organization Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaign     MessagingCampaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  identity     MessagingContactIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)
  customer     Customer?                @relation(fields: [customerId], references: [id], onDelete: SetNull)
  lead         Lead?                    @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@unique([campaignId, idempotencyKey])
  @@index([organizationId, campaignId])
  @@index([campaignId, status])
  @@index([identityId])
  @@map("messaging_campaign_recipients")
}

model MessagingSuppression {
  id              String                    @id @default(uuid())
  organizationId  String                    @map("organization_id")
  channel         MessageChannel?
  identityId      String?                   @map("identity_id")
  phoneNormalized String?                   @map("phone_normalized")
  externalUserId  String?                   @map("external_user_id")
  channelAccountRef String?                 @map("channel_account_ref")
  reason          MessagingSuppressionReason
  note            String?
  createdByUserId String?                   @map("created_by_user_id")
  createdAt       DateTime                  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, channel])
  @@index([organizationId, phoneNormalized])
  @@index([organizationId, identityId])
  @@index([organizationId, externalUserId])
  @@map("messaging_suppressions")
}

/// Kết nối Facebook Ads metadata theo organization (token lưu ở AdConnection)
model FacebookAdsConnection {
  id                    String                      @id @default(uuid())
  organizationId        String                      @unique @map("organization_id")
  /// User thực hiện OAuth gần nhất (audit) — không dùng làm scope dữ liệu
  connectedByUserId     String                      @map("connected_by_user_id")
  selectedAdAccountId   String?                     @map("selected_ad_account_id")
  selectedAdAccountName String?                     @map("selected_ad_account_name")
  facebookUserId        String?                     @map("facebook_user_id")
  status                FacebookAdsConnectionStatus @default(DISCONNECTED)
  scopes                String[]                    @default([])
  lastSyncAt            DateTime?                   @map("last_sync_at")
  lastSyncStatus        FacebookAdsSyncStatus?      @map("last_sync_status")
  lastSyncError         String?                     @map("last_sync_error")
  createdAt             DateTime                    @default(now()) @map("created_at")
  updatedAt             DateTime                    @updatedAt @map("updated_at")

  organization      Organization                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connectedBy       User                          @relation("FacebookAdsConnectedBy", fields: [connectedByUserId], references: [id], onDelete: Cascade)
  syncLogs          FacebookAdsSyncLog[]
  campaignSnapshots FacebookAdsCampaignSnapshot[]

  @@index([connectedByUserId])
  @@map("facebook_ads_connections")
}

model FacebookAdsSyncLog {
  id              String                @id @default(uuid())
  organizationId  String                @map("organization_id")
  adAccountId     String                @map("ad_account_id")
  dateFrom        DateTime              @map("date_from") @db.Date
  dateTo          DateTime              @map("date_to") @db.Date
  syncStartedAt   DateTime              @map("sync_started_at")
  syncFinishedAt  DateTime?             @map("sync_finished_at")
  status          FacebookAdsSyncStatus
  errorMessage    String?               @map("error_message")
  campaignsSynced Int                   @default(0) @map("campaigns_synced")

  connection FacebookAdsConnection @relation(fields: [organizationId], references: [organizationId], onDelete: Cascade)

  @@index([organizationId, syncStartedAt])
  @@map("facebook_ads_sync_logs")
}

model FacebookAdsCampaignSnapshot {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  adAccountId    String   @map("ad_account_id")
  campaignId     String   @map("campaign_id")
  campaignName   String   @map("campaign_name")
  objective      String?
  campaignType   String   @map("campaign_type")
  dateFrom       DateTime @map("date_from") @db.Date
  dateTo         DateTime @map("date_to") @db.Date
  spend          Decimal  @default(0) @db.Decimal(14, 2)
  impressions    Int      @default(0)
  reach          Int      @default(0)
  frequency      Decimal  @default(0) @db.Decimal(10, 4)
  cpm            Decimal  @default(0) @db.Decimal(14, 4)
  cpc            Decimal  @default(0) @db.Decimal(14, 4)
  ctr            Decimal  @default(0) @db.Decimal(10, 4)
  clicks         Int      @default(0)
  results        Decimal  @default(0) @db.Decimal(14, 2)
  costPerResult  Decimal  @default(0) @map("cost_per_result") @db.Decimal(14, 4)
  purchaseRoas   Decimal? @map("purchase_roas") @db.Decimal(14, 4)
  resultRate     Decimal  @default(0) @map("result_rate") @db.Decimal(10, 4)
  syncedAt       DateTime @map("synced_at")

  connection FacebookAdsConnection @relation(fields: [organizationId], references: [organizationId], onDelete: Cascade)

  @@unique([organizationId, campaignId, dateFrom, dateTo])
  @@index([organizationId, adAccountId])
  @@map("facebook_ads_campaign_snapshots")
}

/// Marketing message campaign (queue worker) — tách biệt AdCampaign
model Campaign {
  id             String                  @id @default(uuid())
  organizationId String                  @map("organization_id")
  name           String
  status         MarketingCampaignStatus @default(DRAFT)
  channel        MessageChannel
  scheduledAt    DateTime?               @map("scheduled_at")
  sentCount      Int                     @default(0) @map("sent_count")
  createdAt      DateTime                @default(now()) @map("created_at")
  updatedAt      DateTime                @updatedAt @map("updated_at")

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customers    CampaignCustomer[]

  @@index([organizationId, status])
  @@map("campaigns")
}

model CampaignCustomer {
  campaignId String @map("campaign_id")
  customerId String @map("customer_id")

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@id([campaignId, customerId])
  @@map("campaign_customers")
}

