  utmSource      String?     @map("utm_source")
  utmMedium      String?     @map("utm_medium")
  utmCampaign    String?     @map("utm_campaign")
  utmContent     String?     @map("utm_content")
  utmTerm        String?     @map("utm_term")
  fbclid         String?
  gclid          String?
  adCampaignId   String?     @map("ad_campaign_id")
  adSetId        String?     @map("ad_set_id")
  adId           String?     @map("ad_id")
  externalCampaignId String? @map("external_campaign_id")
  externalAdSetId    String? @map("external_ad_set_id")
  externalAdId       String? @map("external_ad_id")
  landingPage    String?     @map("landing_page") @db.Text
  referrer       String?     @db.Text
  firstTouchJson Json?       @map("first_touch_json")
  lastTouchJson  Json?       @map("last_touch_json")
  rawPayload     Json?       @map("raw_payload")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

