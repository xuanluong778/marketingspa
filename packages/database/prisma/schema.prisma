// =============================================================================
// Email Marketing — org-scoped (Prompt Email Marketing)
// =============================================================================

enum EmailCampaignStatus {
  DRAFT
  SCHEDULED
  RUNNING
  PAUSED
  COMPLETED
  CANCELLED
}

enum EmailRecipientStatus {
  PENDING
  QUEUED
  SENT
  DELIVERED
  OPENED
  CLICKED
  BOUNCED
  FAILED
  UNSUBSCRIBED
  SKIPPED
}

enum EmailEventType {
  SENT
  DELIVERED
  OPEN
  CLICK
  BOUNCE
  UNSUBSCRIBE
  COMPLAINT
  FAILED
}

enum EmailContactStatus {
  SUBSCRIBED
  UNSUBSCRIBED
  BOUNCED
}

enum EmailDomainStatus {
  PENDING
  VERIFIED
  FAILED
}

enum EmailSuppressionReason {
  UNSUBSCRIBE
  BOUNCE
  COMPLAINT
  MANUAL
}

enum EmailAutomationTrigger {
  NEW_CONTACT
  LIST_JOIN
  SCHEDULED
  NEW_LEAD
  EMAIL_OPENED
  EMAIL_CLICKED
  EMAIL_NOT_OPENED
  FUNNEL_SIGNUP
  BOOKING_CREATED
  PURCHASED
}

enum EmailAutomationAction {
  SEND_EMAIL
  ADD_LEAD_SCORE
  SET_CRM_STAGE
}

enum EmailAutomationStatus {
  DRAFT
  ACTIVE
  PAUSED
}

model EmailSenderDomain {
  id             String            @id @default(uuid())
  organizationId String            @map("organization_id")
  domain         String
  fromName       String            @map("from_name")
  fromEmail      String            @map("from_email")
  replyTo        String?           @map("reply_to")
  status         EmailDomainStatus @default(PENDING)
  dkimHost       String?           @map("dkim_host")
  dkimValue      String?           @map("dkim_value")
  spfValue       String?           @map("spf_value")
  dmarcHost      String?           @map("dmarc_host")
  dmarcValue     String?           @map("dmarc_value")
  dkimRecords    Json              @default("[]") @map("dkim_records")
  dkimVerified   Boolean           @default(false) @map("dkim_verified")
  spfVerified    Boolean           @default(false) @map("spf_verified")
  dmarcVerified  Boolean           @default(false) @map("dmarc_verified")
  lastCheckedAt  DateTime?         @map("last_checked_at")
  verifiedAt     DateTime?         @map("verified_at")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaigns    EmailCampaign[]

  @@unique([organizationId, domain])
  @@index([organizationId, status])
  @@map("email_sender_domains")
}

model EmailTemplate {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  subject        String
  previewText    String?  @map("preview_text")
  htmlBody       String   @map("html_body") @db.Text
  textBody       String?  @map("text_body") @db.Text
  category       String?
  isActive       Boolean  @default(true) @map("is_active")
  createdByUserId String? @map("created_by_user_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaigns    EmailCampaign[]
  automations  EmailAutomation[]

  @@index([organizationId, isActive])
  @@map("email_templates")
}

model EmailContact {
  id             String             @id @default(uuid())
  organizationId String             @map("organization_id")
  email          String
  name           String?
  phone          String?
  source         String?
  tags           String[]            @default([])
  crmStage       String?            @map("crm_stage")
  customerId     String?            @map("customer_id")
  leadId         String?            @map("lead_id")
  status         EmailContactStatus @default(SUBSCRIBED)
  customFields   Json               @default("{}") @map("custom_fields")
  unsubscribedAt DateTime?          @map("unsubscribed_at")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  organization Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer?                @relation(fields: [customerId], references: [id], onDelete: SetNull)
  listMembers  EmailListMember[]
  recipients   EmailCampaignRecipient[]
  events       EmailEvent[]

  @@unique([organizationId, email])
  @@index([organizationId, status])
  @@index([organizationId, source])
  @@index([organizationId, crmStage])
  @@index([organizationId, customerId])
  @@map("email_contacts")
}

model EmailList {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  description    String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members      EmailListMember[]
  campaigns    EmailCampaign[]
  automations  EmailAutomation[]

  @@index([organizationId])
  @@map("email_lists")
}

model EmailListMember {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  listId         String   @map("list_id")
  contactId      String   @map("contact_id")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  list         EmailList    @relation(fields: [listId], references: [id], onDelete: Cascade)
  contact      EmailContact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([listId, contactId])
  @@index([organizationId, listId])
  @@index([contactId])
  @@map("email_list_members")
}

model EmailSegment {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  rules          Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaigns    EmailCampaign[]

  @@index([organizationId])
  @@map("email_segments")
}

model EmailCampaign {
  id               String              @id @default(uuid())
  organizationId   String              @map("organization_id")
  name             String
  subject          String?
  templateId       String?             @map("template_id")
  listId           String?             @map("list_id")
  segmentId        String?             @map("segment_id")
  senderDomainId   String?             @map("sender_domain_id")
  status           EmailCampaignStatus @default(DRAFT)
  /** Explicit contact pick from wizard (empty = use list/segment/all). Org-scoped at plan time. */
  selectedContactIds String[]          @default([]) @map("selected_contact_ids")
  scheduledAt      DateTime?           @map("scheduled_at")
  startedAt        DateTime?           @map("started_at")
  completedAt      DateTime?           @map("completed_at")
  totalRecipients  Int                 @default(0) @map("total_recipients")
  queuedCount      Int                 @default(0) @map("queued_count")
  sentCount        Int                 @default(0) @map("sent_count")
  deliveredCount   Int                 @default(0) @map("delivered_count")
  openCount        Int                 @default(0) @map("open_count")
  clickCount       Int                 @default(0) @map("click_count")
  bounceCount      Int                 @default(0) @map("bounce_count")
  failCount        Int                 @default(0) @map("fail_count")
  unsubscribeCount Int                 @default(0) @map("unsubscribe_count")
  createdByUserId  String?             @map("created_by_user_id")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  organization Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  template     EmailTemplate?           @relation(fields: [templateId], references: [id], onDelete: SetNull)
  list         EmailList?               @relation(fields: [listId], references: [id], onDelete: SetNull)
  segment      EmailSegment?            @relation(fields: [segmentId], references: [id], onDelete: SetNull)
  senderDomain EmailSenderDomain?       @relation(fields: [senderDomainId], references: [id], onDelete: SetNull)
  recipients   EmailCampaignRecipient[]
  events       EmailEvent[]

  @@index([organizationId, status])
  @@index([organizationId, scheduledAt])
  @@map("email_campaigns")
}

model EmailCampaignRecipient {
  id             String               @id @default(uuid())
  organizationId String               @map("organization_id")
  campaignId     String               @map("campaign_id")
  contactId      String               @map("contact_id")
  email          String
  status         EmailRecipientStatus @default(PENDING)
  skipReason     String?              @map("skip_reason")
  lastError      String?              @map("last_error")
  attemptCount   Int                  @default(0) @map("attempt_count")
  queuedAt       DateTime?            @map("queued_at")
  sentAt         DateTime?            @map("sent_at")
  deliveredAt    DateTime?            @map("delivered_at")
  failedAt       DateTime?            @map("failed_at")
  openedAt       DateTime?            @map("opened_at")
  clickedAt      DateTime?            @map("clicked_at")
  bouncedAt      DateTime?            @map("bounced_at")
  provider       String?
  providerMessageId String?           @map("provider_message_id")
  idempotencyKey String?              @map("idempotency_key")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaign     EmailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact      EmailContact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  events       EmailEvent[]

  @@unique([campaignId, contactId])
  @@index([organizationId, campaignId])
  @@index([campaignId, status])
  @@index([providerMessageId])
  @@index([campaignId, idempotencyKey])
  @@map("email_campaign_recipients")
}

/// Transactional / routed outbound sends (SES/Brevo) — multi-tenant + idempotency.
model EmailOutboundMessage {
  id                String    @id @default(uuid())
  organizationId    String    @map("organization_id")
  purpose           String    @default("transactional")
  toEmail           String    @map("to_email")
  subject           String?
  provider          String?
  providerMessageId String?   @map("provider_message_id")
  status            String    @default("PENDING")
  idempotencyKey    String    @map("idempotency_key")
  sentAt            DateTime? @map("sent_at")
  deliveredAt       DateTime? @map("delivered_at")
  failedAt          DateTime? @map("failed_at")
  lastError         String?   @map("last_error")
  metadata          Json      @default("{}")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, purpose, createdAt])
  @@index([providerMessageId])
  @@map("email_outbound_messages")
}

model EmailEvent {
  id             String         @id @default(uuid())
  organizationId String         @map("organization_id")
  campaignId     String?        @map("campaign_id")
  recipientId    String?        @map("recipient_id")
  contactId      String?        @map("contact_id")
  type           EmailEventType
  metadata       Json           @default("{}")
  occurredAt     DateTime       @default(now()) @map("occurred_at")

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaign     EmailCampaign?          @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  recipient    EmailCampaignRecipient? @relation(fields: [recipientId], references: [id], onDelete: SetNull)
  contact      EmailContact?           @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([organizationId, type, occurredAt])
  @@index([campaignId, type])
  @@index([contactId])
  @@map("email_events")
}

model EmailSuppression {
  id             String                  @id @default(uuid())
  organizationId String                  @map("organization_id")
  email          String
  reason         EmailSuppressionReason
  note           String?
  createdAt      DateTime                @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, email])
  @@index([organizationId, reason])
  @@map("email_suppressions")
}

/// Idempotent Brevo/SES webhook deliveries (no plaintext secrets).
model EmailWebhookEvent {
  id             String    @id @default(uuid())
  organizationId String?   @map("organization_id")
  provider       String    @default("brevo")
  eventKey       String    @map("event_key")
  eventKind      String    @map("event_kind")
  messageId      String?   @map("message_id")
  recipientId    String?   @map("recipient_id")
  campaignId     String?   @map("campaign_id")
  processedAt    DateTime  @default(now()) @map("processed_at")
  metadata       Json      @default("{}")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@unique([provider, eventKey])
  @@index([messageId])
  @@index([organizationId, processedAt])
  @@map("email_webhook_events")
}

model EmailAutomation {
  id             String                 @id @default(uuid())
  organizationId String                 @map("organization_id")
  name           String
  trigger        EmailAutomationTrigger
  status         EmailAutomationStatus  @default(DRAFT)
  templateId     String?                @map("template_id")
  listId         String?                @map("list_id")
  delayMinutes   Int                    @default(0) @map("delay_minutes")
  recipeId       String?                @map("recipe_id")
  action         EmailAutomationAction  @default(SEND_EMAIL)
  scoreDelta     Int                    @default(10) @map("score_delta")
  targetStage    String?                @map("target_stage")
  waitDays       Int                    @default(2) @map("wait_days")
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  template     EmailTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  list         EmailList?     @relation(fields: [listId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([organizationId, trigger])
  @@map("email_automations")
}
