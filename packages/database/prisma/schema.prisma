  id               String   @id @default(uuid())
  /// null = system catalog template
  organizationId   String?  @map("organization_id")
  /// When cloned from system/another template
  sourceTemplateId String?  @map("source_template_id")
  createdById      String?  @map("created_by_id")
  slug             String
  name             String
  description      String?  @db.Text
  category         String?
  tags             String[] @default([])
  goal             Json
  requiredInputs   Json     @default("[]") @map("required_inputs")
  nodes            Json     @default("[]")
  connections      Json     @default("[]")
  recommendedAutomation Json @default("[]") @map("recommended_automation")
  /// Full validated FunnelTemplateDefinition snapshot
  definition       Json
  isSystem         Boolean  @default(false) @map("is_system")
  isActive         Boolean  @default(true) @map("is_active")
  version          Int      @default(1)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  organization   Organization?   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sourceTemplate FunnelTemplate? @relation("FunnelTemplateClones", fields: [sourceTemplateId], references: [id], onDelete: SetNull)
  clones         FunnelTemplate[] @relation("FunnelTemplateClones")

  @@index([organizationId, isActive])
  @@index([slug])
  @@index([isSystem, slug])
  @@map("funnel_templates")
}
model FunnelRecommendation {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  createdById    String?  @map("created_by_id")
  prompt         String   @db.Text
  /// Validated FunnelGeneratorResult JSON (schemaVersion funnel-generator.v1)
  result         Json
  source         String   @default("ai") /// ai | fallback
  /// Optional: user selected templateSlug later (still no apply here)
  selectedSlug   String?  @map("selected_slug")
  selectedAt     DateTime? @map("selected_at")
  /// Validated FunnelCompleteSpec JSON (schemaVersion funnel-complete.v1) — working draft
  completeSpec   Json?     @map("complete_spec")
  completeSource String?   @map("complete_source") /// ai | fallback
  completeGeneratedAt DateTime? @map("complete_generated_at")
  /// Bound CSKH bot (existing engine) — Prompt 8
  chatbotBotId   String?   @map("chatbot_bot_id")
  /// Prompt 16 — publish lifecycle
  status         FunnelPublishStatus @default(DRAFT)
  /// Frozen spec served to public leads while ACTIVE (edits go to completeSpec)
  publishedSpec  Json?     @map("published_spec")
  publishedVersion Int     @default(0) @map("published_version")
  publishedAt    DateTime? @map("published_at")
  pausedAt       DateTime? @map("paused_at")
  archivedAt     DateTime? @map("archived_at")
  clonedFromId   String?   @map("cloned_from_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  chatbotBot       ChatbotBot?       @relation(fields: [chatbotBotId], references: [id], onDelete: SetNull)
  clonedFrom       FunnelRecommendation?  @relation("FunnelClones", fields: [clonedFromId], references: [id], onDelete: SetNull)
  clones           FunnelRecommendation[] @relation("FunnelClones")
  versions         FunnelVersion[]
  leads            Lead[]
  automationFlows  AutomationFlow[]
  scoringConfig    FunnelScoringConfig?
  funnelEvents     MarketingFunnelEvent[]
  runtimeLogs      FunnelRuntimeLog[]

  @@index([organizationId, createdAt])
  @@index([organizationId, status])
  @@index([chatbotBotId])
  @@index([clonedFromId])
  @@map("funnel_recommendations")
}
model FunnelVersion {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  funnelId       String   @map("funnel_id")
  version        Int
  spec           Json
  summary        String?  @db.VarChar(500)
  createdById    String?  @map("created_by_id")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  funnel       FunnelRecommendation @relation(fields: [funnelId], references: [id], onDelete: Cascade)

  @@unique([funnelId, version])
  @@index([organizationId, funnelId])
  @@map("funnel_versions")
}
model FunnelScoringConfig {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  funnelId       String   @unique @map("funnel_id")
  maxScore       Int      @default(100) @map("max_score")
