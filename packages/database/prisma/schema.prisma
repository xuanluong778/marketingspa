// =============================================================================
// AI Ads Manager — organization-scoped (credential duy nhất: AdConnection)
// =============================================================================

model AdConnection {
  id                   String               @id @default(uuid())
  /// User thực hiện connect gần nhất (audit) — scope dữ liệu theo organizationId
  userId               String               @map("user_id")
  organizationId       String               @map("organization_id")
  provider             AdConnectionProvider
  status               AdConnectionStatus   @default(DISCONNECTED)
  encryptedCredentials String?              @map("encrypted_credentials") @db.Text
  tokenExpiresAt       DateTime?            @map("token_expires_at")
  scopes               String[]             @default([])
  externalAccountId    String?              @map("external_account_id")
  externalAccountName  String?              @map("external_account_name")
  metadata             Json                 @default("{}")
  lastSyncAt           DateTime?            @map("last_sync_at")
  lastError            String?              @map("last_error")
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  syncJobs     AdsSyncJob[]

  @@unique([organizationId, provider])
  @@index([userId])
  @@map("ad_connections")
}

/// Job đồng bộ Ads qua BullMQ — payload queue chỉ chứa ID, không chứa token
model AdsSyncJob {
  id                 String            @id @default(uuid())
  organizationId     String            @map("organization_id")
  connectionId       String            @map("connection_id")
  accountId          String            @map("account_id")
  platform           AdsSyncPlatform   @default(META)
  status             AdsSyncJobStatus  @default(QUEUED)
  dateFrom           DateTime          @map("date_from") @db.Date
  dateTo             DateTime          @map("date_to") @db.Date
  /// Hash ổn định để idempotent (org+connection+account+dates+platform)
  idempotencyKey     String            @map("idempotency_key")
  progressPercent    Int               @default(0) @map("progress_percent")
  progressMessage    String?           @map("progress_message")
  campaignsSynced    Int               @default(0) @map("campaigns_synced")
  attemptCount       Int               @default(0) @map("attempt_count")
  maxAttempts        Int               @default(5) @map("max_attempts")
  lastError          String?           @map("last_error") @db.Text
  bullJobId          String?           @map("bull_job_id")
  lockedAt           DateTime?         @map("locked_at")
  lockOwner          String?           @map("lock_owner")
  startedAt          DateTime?         @map("started_at")
  finishedAt         DateTime?         @map("finished_at")
  requestedByUserId  String?           @map("requested_by_user_id")
  metadata           Json              @default("{}")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connection   AdConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([idempotencyKey])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, platform, accountId, status])
  @@index([connectionId])
  @@map("ads_sync_jobs")
}

model AdPlatformAccount {
  id             String     @id @default(uuid())
  userId         String     @map("user_id")
  organizationId String     @map("organization_id")
  platform       AdPlatform
  externalId     String     @map("external_id")
  name           String
  currency       String     @default("VND")
  timezone       String     @default("UTC")
  isActive       Boolean    @default(true) @map("is_active")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaigns AdManagerCampaign[]

  @@unique([userId, platform, externalId])
  @@index([organizationId])
  @@map("ad_manager_accounts")
}

model AdManagerCampaign {
  id             String           @id @default(uuid())
  userId         String           @map("user_id")
  organizationId String           @map("organization_id")
  accountId      String           @map("account_id")
  platform       AdPlatform
  externalId     String           @map("external_id")
  name           String
  status         AdCampaignStatus @default(ACTIVE)
  budget         Decimal?         @db.Decimal(14, 2)
  objective      String?
  startDate      DateTime?        @map("start_date") @db.Date
  endDate        DateTime?        @map("end_date") @db.Date
  lastSyncedAt   DateTime?        @map("last_synced_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  account      AdPlatformAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  insights     AdInsight[]
  logs         AdAutomationLog[]
  recommendations AdAiRecommendation[]

  @@unique([userId, platform, externalId])
  @@index([organizationId, status])
  @@index([accountId])
  @@map("ad_manager_campaigns")
}

model AdInsight {
  id               String     @id @default(uuid())
  userId           String     @map("user_id")
  organizationId   String     @map("organization_id")
  campaignId       String?    @map("campaign_id")
  platform         AdPlatform
  externalCampaignId String   @map("external_campaign_id")
  campaignName     String     @map("campaign_name")
  dateFrom         DateTime   @map("date_from") @db.Date
  dateTo           DateTime   @map("date_to") @db.Date
  /// Alias ngày chính (thường = dateFrom khi range 1 ngày; hoặc dateFrom của cửa sổ sync)
  date             DateTime?  @db.Date
  spend            Decimal    @default(0) @db.Decimal(18, 6)
  revenue          Decimal    @default(0) @db.Decimal(18, 6)
  conversionValue  Decimal    @default(0) @map("conversion_value") @db.Decimal(18, 6)
  impressions      Int        @default(0)
  clicks           Int        @default(0)
  ctr              Decimal?   @db.Decimal(18, 8)
  cpc              Decimal?   @db.Decimal(18, 8)
  cpm              Decimal?   @db.Decimal(18, 8)
  reach            Int        @default(0)
  frequency        Decimal    @default(0) @db.Decimal(18, 8)
  conversions      Decimal    @default(0) @db.Decimal(18, 6)
  leads            Decimal    @default(0) @db.Decimal(18, 6)
  cpa              Decimal?   @db.Decimal(18, 8)
  cpl              Decimal?   @db.Decimal(18, 8)
  roas             Decimal?   @db.Decimal(18, 8)
  currency         String     @default("USD")
  timezone         String     @default("UTC")
  /// [{ type, count, value? }] — conversion type/action rõ ràng
  conversionActions Json      @default("[]") @map("conversion_actions")
  efficiencyScore  Int?       @map("efficiency_score")
  aiSuggestion     String?    @map("ai_suggestion") @db.Text
  rawMetrics       Json       @default("{}") @map("raw_metrics")
  syncedAt         DateTime   @map("synced_at")

  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaign AdManagerCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@unique([userId, platform, externalCampaignId, dateFrom, dateTo])
  @@index([organizationId, dateFrom])
  @@index([organizationId, platform, dateFrom])
  @@index([campaignId])
  @@map("ad_insights")
}

model AdManagerSettings {
  id                      String   @id @default(uuid())
  userId                  String   @unique @map("user_id")
  organizationId          String   @map("organization_id")
  autoModeEnabled         Boolean  @default(false) @map("auto_mode_enabled")
  /// OBSERVE = chỉ đề xuất | SUGGEST = chờ duyệt | AUTO = tự động trong giới hạn
  mcpMode                 String   @default("SUGGEST") @map("mcp_mode")
