/// Meta Data Deletion callback — trạng thái theo confirmation_code (idempotent theo facebookUserId)
enum AutoPostMetaDeletionStatus {
  PENDING
  COMPLETED
  NOT_FOUND
}

model AutoPostMetaDataDeletionRequest {
  id                 String                     @id @default(uuid())
  confirmationCode   String                     @unique @map("confirmation_code")
  facebookUserId     String                     @unique @map("facebook_user_id")
  status             AutoPostMetaDeletionStatus @default(PENDING)
  userIdsAffected    String[]                   @default([]) @map("user_ids_affected")
  organizationIds    String[]                   @default([]) @map("organization_ids")
  postsAnonymized    Int                        @default(0) @map("posts_anonymized")
  pagesRemoved       Int                        @default(0) @map("pages_removed")
  scheduledCancelled Int                        @default(0) @map("scheduled_cancelled")
  completedAt        DateTime?                  @map("completed_at")
  createdAt          DateTime                   @default(now()) @map("created_at")
  updatedAt          DateTime                   @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@map("auto_post_meta_data_deletion_requests")
}

/// Meta Deauthorize callback — idempotent theo (facebookUserId, issuedAt)
model AutoPostMetaDeauthorizeEvent {
  id              String   @id @default(uuid())
  facebookUserId  String   @map("facebook_user_id")
  issuedAt        Int      @map("issued_at")
  userIdsAffected String[] @default([]) @map("user_ids_affected")
  pagesRemoved    Int      @default(0) @map("pages_removed")
  jobsCancelled   Int      @default(0) @map("jobs_cancelled")
  createdAt       DateTime @default(now()) @map("created_at")

  @@unique([facebookUserId, issuedAt])
  @@index([facebookUserId])
  @@map("auto_post_meta_deauthorize_events")
}

/// Facebook Login for Business — chống CSRF/replay cho OAuth state
model AutoPostFacebookOAuthState {
