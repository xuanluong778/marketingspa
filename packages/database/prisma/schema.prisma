  sourceRoute       String?  @map("source_route") @db.VarChar(500)
  sourceTitle       String   @map("source_title") @db.VarChar(500)
  originalScript    String   @map("original_script") @db.Text
  editedScript      String   @map("edited_script") @db.Text
