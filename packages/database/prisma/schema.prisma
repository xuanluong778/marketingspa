enum VideoTranscriptionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum VideoTranscriptionStage {
  QUEUED
  VALIDATING
  DOWNLOADING
  EXTRACTING_AUDIO
  TRANSCRIBING
  CLEANING
  COMPLETED
  FAILED
  CANCELLED
}

enum VideoTranscriptionSourceType {
  UPLOAD
  YOUTUBE
  FACEBOOK
  TIKTOK
}

/// Job lấy văn bản từ video/audio — tenant-scoped (user + organization)
model VideoTranscription {
  id                  String                       @id @default(uuid())
  organizationId      String                       @map("organization_id")
  userId              String                       @map("user_id")
  status              VideoTranscriptionStatus     @default(PENDING)
  stage               VideoTranscriptionStage      @default(QUEUED)
  sourceType          VideoTranscriptionSourceType @map("source_type")
  sourceUrl           String?                      @map("source_url") @db.VarChar(2000)
  sourceTitle         String?                      @map("source_title") @db.VarChar(500)
  thumbnailUrl        String?                      @map("thumbnail_url") @db.VarChar(2000)
  originalFilename    String?                      @map("original_filename") @db.VarChar(500)
  language            String                       @default("auto") @db.VarChar(16)
  ownershipConfirmed  Boolean                      @default(false) @map("ownership_confirmed")
  /// Soft-cancel flag — worker checks between stages/chunks
  cancelRequested     Boolean                      @default(false) @map("cancel_requested")
  /// Tên riêng / từ chuyên ngành (user nhập + org glossary)
  glossaryTerms       String[]                     @default([]) @map("glossary_terms")
  rawTranscript       String?                      @map("raw_transcript") @db.Text
  /// Bản đã chuẩn hóa tiếng Việt + glossary (alias cleaned)
  cleanedTranscript   String?                      @map("cleaned_transcript") @db.Text
  correctedTranscript String?                      @map("corrected_transcript") @db.Text
  /// Meta chất lượng: codec, bitrate, models, retries
  qualityMeta         Json?                        @map("quality_meta")
  durationSeconds     Int?                         @map("duration_seconds")
  /// Thời lượng audio sau FFmpeg (nguồn chân thực để gate COMPLETED)
  audioDurationSeconds Float?                      @map("audio_duration_seconds")
  processedDurationSeconds Float?                  @map("processed_duration_seconds")
  chunkCount          Int?                         @map("chunk_count")
  chunksCompleted     Int?                         @map("chunks_completed")
  /// Tiến độ từng chunk (JSON TranscriptProgressSnapshot)
  chunkProgress       Json?                        @map("chunk_progress")
  fileSizeBytes       BigInt?                      @map("file_size_bytes")
  detectedLanguage    String?                      @map("detected_language") @db.VarChar(16)
  errorCode           String?                      @map("error_code") @db.VarChar(80)
  errorMessage        String?                      @map("error_message") @db.Text
  bullJobId           String?                      @map("bull_job_id") @db.VarChar(120)
  attemptCount        Int                          @default(0) @map("attempt_count")
  /// Absolute temp work dir — xóa sau hoàn tất / fail cuối
  tempDir             String?                      @map("temp_dir") @db.VarChar(1000)
  workDirRelative     String?                      @map("work_dir_relative") @db.VarChar(500)
  /// After complete, keep media until this time for download then wipe
  tempExpiresAt       DateTime?                    @map("temp_expires_at")
  createdAt           DateTime                     @default(now()) @map("created_at")
  updatedAt           DateTime                     @updatedAt @map("updated_at")
  completedAt         DateTime?                    @map("completed_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, userId, createdAt])
  @@index([organizationId, id])
  @@index([organizationId, status, createdAt])
  @@index([tempExpiresAt])
  @@map("video_transcriptions")
}

/// Từ điển tên riêng / thuật ngữ theo user trong org (dùng lại giữa các lần lấy văn bản)
