// Prisma schema - MarketingSpa SaaS (multi-tenant)
// Mọi bảng nghiệp vụ đều gắn organizationId để cô lập dữ liệu theo spa

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

