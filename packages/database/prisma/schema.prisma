  employeeIds    String[]           @default([]) @map("employee_ids")
  lastIndex      Int                @default(0) @map("last_index")
  isActive       Boolean            @default(true) @map("is_active")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([organizationId, branchId])
  @@map("lead_assignment_rules")
}

model Order {
  id             String      @id @default(uuid())
  organizationId String      @map("organization_id")
  branchId       String?     @map("branch_id")
  customerId     String      @map("customer_id")
  leadId         String?     @map("lead_id")
  orderNumber    String      @map("order_number")
  status         OrderStatus @default(PENDING)
  subtotal       Decimal     @default(0) @db.Decimal(12, 2)
  discount       Decimal     @default(0) @db.Decimal(12, 2)
  total          Decimal     @default(0) @db.Decimal(12, 2)
  note           String?
  orderedAt      DateTime    @default(now()) @map("ordered_at")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  lead         Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  items        OrderItem[]
  payments     Payment[]

  @@unique([organizationId, orderNumber])
  @@index([organizationId, orderedAt])
  @@index([customerId])
  @@index([leadId])
  @@map("orders")
}

model OrderItem {
  id         String  @id @default(uuid())
  orderId    String  @map("order_id")
  serviceId  String? @map("service_id")
  name       String
  quantity   Int     @default(1)
  unitPrice  Decimal @map("unit_price") @db.Decimal(12, 2)
  totalPrice Decimal @map("total_price") @db.Decimal(12, 2)

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  service Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("order_items")
}

model Payment {
  id             String        @id @default(uuid())
  organizationId String        @map("organization_id")
  orderId        String        @map("order_id")
  amount         Decimal       @db.Decimal(12, 2)
  method         PaymentMethod @default(CASH)
  status         PaymentStatus @default(PENDING)
  reference      String?
  paidAt         DateTime?     @map("paid_at")
  createdAt      DateTime      @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  order        Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([organizationId, paidAt])
  @@index([organizationId, status, paidAt])
  @@index([orderId])
  @@map("payments")
}

model Expense {
  id             String          @id @default(uuid())
  organizationId String          @map("organization_id")
  branchId       String?         @map("branch_id")
  adCampaignId   String?         @map("ad_campaign_id")
  category       ExpenseCategory
  description    String
  amount         Decimal         @db.Decimal(12, 2)
  expenseDate    DateTime        @map("expense_date") @db.Date
  note           String?
  createdAt      DateTime        @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  adCampaign   AdCampaign?  @relation(fields: [adCampaignId], references: [id], onDelete: SetNull)

  @@index([organizationId, expenseDate])
  @@index([category])
  @@map("expenses")
}

/// Catalog sản phẩm bán hàng (tách Service spa / PaymentOrder SaaS)
model SalesProductCategory {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products     SalesProduct[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("sales_product_categories")
}

model SalesProduct {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  categoryId     String?  @map("category_id")
  sku            String?
  barcode        String?
  name           String
  unit           String?  @default("cái")
  price          Decimal  @default(0) @db.Decimal(12, 2)
  costPrice      Decimal  @default(0) @map("cost_price") @db.Decimal(12, 2)
  /// Tổng tồn vật lý = SUM(remainingQuantity) mọi lô còn hàng (kể cả hết hạn)
  stockQty       Int      @default(0) @map("stock_qty")
  minStockQty    Int      @default(0) @map("min_stock_qty")
  isActive       Boolean  @default(true) @map("is_active")
  note           String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category     SalesProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  orderItems   SalesOrderItem[]
  batches      SalesStockBatch[]
  movements    SalesStockMovement[]
  stocktakeLines SalesStocktakeLine[]
  purchaseOrderItems SalesPurchaseOrderItem[]
  reconciliationLines SalesStockReconciliationLine[]

  @@unique([organizationId, sku])
  @@unique([organizationId, barcode])
  @@index([organizationId, name])
  @@index([organizationId, isActive])
  @@index([organizationId, stockQty, minStockQty])
  @@index([organizationId, updatedAt])
  @@index([categoryId])
  @@map("sales_products")
}

/// Lô / batch — FEFO theo expiryDate rồi importedAt
model SalesStockBatch {
  id                String    @id @default(uuid())
  organizationId    String    @map("organization_id")
  productId         String    @map("product_id")
  batchCode         String    @map("batch_code")
  quantity          Int
  remainingQuantity Int       @map("remaining_quantity")
  importedAt        DateTime  @default(now()) @map("imported_at")
  expiryDate        DateTime? @map("expiry_date") @db.Date
  unitCost          Decimal   @default(0) @map("unit_cost") @db.Decimal(12, 2)
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product        SalesProduct             @relation(fields: [productId], references: [id], onDelete: Cascade)
  movementLines  SalesStockMovementLine[]

  @@unique([organizationId, productId, batchCode])
  @@index([organizationId, productId, expiryDate])
  @@index([organizationId, productId, expiryDate, importedAt])
  @@index([productId, remainingQuantity])
  @@map("sales_stock_batches")
}

enum SalesStockMovementType {
  INBOUND
  OUTBOUND
  ADJUST
  RETURN_IN
}

/// Lịch sử nhập/xuất/điều chỉnh — append-only (không sửa/xóa)
model SalesStockMovement {
  id             String                 @id @default(uuid())
  organizationId String                 @map("organization_id")
  type           SalesStockMovementType
  productId      String                 @map("product_id")
  quantity       Int
  reason         String?
  note           String?
  performedById  String?                @map("performed_by_id")
  referenceType  String?                @map("reference_type") /// SALES_ORDER | MANUAL | ...
  referenceId    String?                @map("reference_id")
  createdAt      DateTime               @default(now()) @map("created_at")

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product      SalesProduct            @relation(fields: [productId], references: [id], onDelete: Restrict)
  lines        SalesStockMovementLine[]

  @@index([organizationId, createdAt])
  @@index([organizationId, type])
  @@index([productId, createdAt])
  @@index([referenceType, referenceId])
  @@map("sales_stock_movements")
}

model SalesStockMovementLine {
  id         String @id @default(uuid())
  movementId String @map("movement_id")
  batchId    String @map("batch_id")
  quantity   Int

  movement SalesStockMovement @relation(fields: [movementId], references: [id], onDelete: Cascade)
  batch    SalesStockBatch    @relation(fields: [batchId], references: [id], onDelete: Restrict)

  @@index([movementId])
  @@index([batchId])
  @@map("sales_stock_movement_lines")
}

model SalesOrder {
  id             String           @id @default(uuid())
  organizationId String           @map("organization_id")
  branchId       String?          @map("branch_id")
  customerId     String           @map("customer_id")
  /// Mã đơn tự động SO-YYYYMMDD-XXXX
  code           String
  status         SalesOrderStatus @default(DRAFT)
  customerName   String           @map("customer_name")
  phone          String?
  address        String?
  source         String?
  subtotal       Decimal          @default(0) @db.Decimal(12, 2)
  discount       Decimal          @default(0) @db.Decimal(12, 2)
  shippingFee    Decimal          @default(0) @map("shipping_fee") @db.Decimal(12, 2)
  total          Decimal          @default(0) @db.Decimal(12, 2)
  note           String?
  /// Payment lifecycle (tách khỏi order status)
  paymentStatus  SalesPaymentStatus @default(UNPAID) @map("payment_status")
  amountPaid     Decimal            @default(0) @map("amount_paid") @db.Decimal(12, 2)
  paymentMethod  String?            @map("payment_method")
  paidAt         DateTime?          @map("paid_at")
  transactionRef String?            @map("transaction_ref")
  /// Đã xuất kho (nút Xuất hàng)
  exportedAt     DateTime?        @map("exported_at")
  exportedById   String?          @map("exported_by_id")
  createdById    String?          @map("created_by_id")
  confirmedAt    DateTime?        @map("confirmed_at")
  readyAt        DateTime?        @map("ready_at")
  shippedAt      DateTime?        @map("shipped_at")
  completedAt    DateTime?        @map("completed_at")
  cancelledAt    DateTime?        @map("cancelled_at")
  returnedAt     DateTime?        @map("returned_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items        SalesOrderItem[]
  payments     SalesPayment[]
  returns      SalesReturn[]

  @@unique([organizationId, code])
  @@index([organizationId, createdAt])
  @@index([organizationId, status])
  @@index([organizationId, paymentStatus])
  @@index([organizationId, exportedAt])
  @@index([customerId])
  @@map("sales_orders")
}

model SalesOrderItem {
  id           String  @id @default(uuid())
  orderId      String  @map("order_id")
  productId    String? @map("product_id")
  productName  String  @map("product_name")
  sku          String?
  quantity     Int     @default(1)
  /// Đã trả (cộng dồn) — không vượt quantity
  returnedQty  Int     @default(0) @map("returned_qty")
  unitPrice    Decimal @map("unit_price") @db.Decimal(12, 2)
  lineDiscount Decimal @default(0) @map("line_discount") @db.Decimal(12, 2)
  totalPrice   Decimal @map("total_price") @db.Decimal(12, 2)

  order   SalesOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product SalesProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)
  returnItems SalesReturnItem[]

  @@index([orderId])
  @@index([productId])
  @@map("sales_order_items")
}

/// Giao dịch thu/chi gắn đơn bán
model SalesPayment {
  id             String           @id @default(uuid())
  organizationId String           @map("organization_id")
  orderId        String           @map("order_id")
  kind           SalesPaymentKind @default(PAYMENT)
  amount         Decimal          @db.Decimal(12, 2)
  method         String?
  transactionRef String?          @map("transaction_ref")
  paidAt         DateTime         @default(now()) @map("paid_at")
  note           String?
  performedById  String?          @map("performed_by_id")
  createdAt      DateTime         @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  order        SalesOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([organizationId, orderId, createdAt])
  @@index([organizationId, paidAt])
  @@map("sales_payments")
}

/// Phiếu trả hàng (một phần / toàn phần)
model SalesReturn {
  id             String              @id @default(uuid())
  organizationId String              @map("organization_id")
  orderId        String              @map("order_id")
  code           String
  status         SalesReturnDocStatus @default(DRAFT)
  reason         String?
  note           String?
  refundAmount   Decimal             @default(0) @map("refund_amount") @db.Decimal(12, 2)
  processedById  String?             @map("processed_by_id")
  confirmedAt    DateTime?           @map("confirmed_at")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  order        SalesOrder       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  items        SalesReturnItem[]

  @@unique([organizationId, code])
  @@index([organizationId, orderId, status])
  @@map("sales_returns")
}

model SalesReturnItem {
  id          String  @id @default(uuid())
  returnId    String  @map("return_id")
  orderItemId String  @map("order_item_id")
  productId   String? @map("product_id")
  quantity    Int
  refundAmount Decimal @default(0) @map("refund_amount") @db.Decimal(12, 2)
  reason      String?

  returnDoc SalesReturn    @relation(fields: [returnId], references: [id], onDelete: Cascade)
  orderItem SalesOrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@unique([returnId, orderItemId])
  @@index([orderItemId])
  @@map("sales_return_items")
}

model SalesSupplier {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  phone          String?
  email          String?
  address        String?
  taxCode        String?  @map("tax_code")
  note           String?
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchaseOrders SalesPurchaseOrder[]

  @@index([organizationId, name])
  @@index([organizationId, isActive])
  @@map("sales_suppliers")
}

model SalesPurchaseOrder {
  id             String                  @id @default(uuid())
  organizationId String                  @map("organization_id")
  supplierId     String                  @map("supplier_id")
  code           String
  status         SalesPurchaseOrderStatus @default(DRAFT)
  expectedDate   DateTime?               @map("expected_date")
  note           String?
  subtotal       Decimal                 @default(0) @db.Decimal(12, 2)
  createdById    String?                 @map("created_by_id")
  orderedAt      DateTime?               @map("ordered_at")
  receivedAt     DateTime?               @map("received_at")
  createdAt      DateTime                @default(now()) @map("created_at")
  updatedAt      DateTime                @updatedAt @map("updated_at")

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplier     SalesSupplier           @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  items        SalesPurchaseOrderItem[]

  @@unique([organizationId, code])
  @@index([organizationId, status, createdAt])
  @@index([supplierId])
  @@map("sales_purchase_orders")
}

model SalesPurchaseOrderItem {
  id               String  @id @default(uuid())
  purchaseOrderId  String  @map("purchase_order_id")
  productId        String  @map("product_id")
  productName      String  @map("product_name")
  quantity         Int
  receivedQty      Int     @default(0) @map("received_qty")
  unitCost         Decimal @map("unit_cost") @db.Decimal(12, 2)
  lineTotal        Decimal @map("line_total") @db.Decimal(12, 2)

  purchaseOrder SalesPurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       SalesProduct       @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([purchaseOrderId, productId])
  @@index([productId])
  @@map("sales_purchase_order_items")
}

/// Audit đối soát tồn — không âm thầm sửa stockQty
model SalesStockReconciliation {
  id             String                     @id @default(uuid())
  organizationId String                     @map("organization_id")
  code           String
  status         SalesReconciliationStatus  @default(APPLIED)
  reason         String?
  performedById  String?                    @map("performed_by_id")
  createdAt      DateTime                   @default(now()) @map("created_at")

  organization Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lines        SalesStockReconciliationLine[]

  @@unique([organizationId, code])
  @@index([organizationId, createdAt])
  @@map("sales_stock_reconciliations")
}

model SalesStockReconciliationLine {
  id               String @id @default(uuid())
  reconciliationId String @map("reconciliation_id")
  productId        String @map("product_id")
  beforeQty        Int    @map("before_qty")
  expectedQty      Int    @map("expected_qty")
  delta            Int
  action           String @default("SYNC_STOCK_QTY_TO_BATCH_SUM")

  reconciliation SalesStockReconciliation @relation(fields: [reconciliationId], references: [id], onDelete: Cascade)
  product        SalesProduct             @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([reconciliationId])
  @@index([productId])
  @@map("sales_stock_reconciliation_lines")
}

enum SalesStocktakeStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

/// Phiếu kiểm kê kho — tồn hệ thống vs thực tế → ADJUST khi xác nhận
model SalesStocktake {
  id             String               @id @default(uuid())
  organizationId String               @map("organization_id")
  code           String
  status         SalesStocktakeStatus @default(DRAFT)
  note           String?
  performedById  String?              @map("performed_by_id")
  confirmedAt    DateTime?            @map("confirmed_at")
  confirmedById  String?              @map("confirmed_by_id")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lines        SalesStocktakeLine[]

  @@unique([organizationId, code])
  @@index([organizationId, status, createdAt])
  @@map("sales_stocktakes")
}

model SalesStocktakeLine {
  id          String  @id @default(uuid())
  stocktakeId String  @map("stocktake_id")
  productId   String  @map("product_id")
  /// Tồn hệ thống lúc tạo dòng
  systemQty   Int     @map("system_qty")
  /// Tồn đếm thực tế
  countedQty  Int     @map("counted_qty")
  /// counted - system
  variance    Int     @default(0)
  note        String?

  stocktake SalesStocktake @relation(fields: [stocktakeId], references: [id], onDelete: Cascade)
  product   SalesProduct   @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([stocktakeId, productId])
  @@index([productId])
  @@map("sales_stocktake_lines")
}

// =============================================================================
// Advertising — manual input trước, sau kết nối Meta/Google API
// =============================================================================

model AdAccount {
  id             String     @id @default(uuid())
  organizationId String     @map("organization_id")
  platform       AdPlatform
  name           String
  externalId     String?    @map("external_id")
  currency       String     @default("VND")
  /// IANA timezone của ad account (vd. Asia/Ho_Chi_Minh) — dùng cho date metrics
  timezone       String     @default("UTC") @map("timezone")
  isActive       Boolean    @default(true) @map("is_active")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaigns    AdCampaign[]
  adSets       AdSet[]
  ads          AdCreative[]

  @@index([organizationId, platform])
  @@map("ad_accounts")
  keywords     AdKeyword[]
}
model AdGoogleAdsAccount {
  id              String   @id @default(uuid())
  organizationId  String   @map("organization_id")
  connectionId    String   @map("connection_id")
  customerId      String   @map("customer_id")
  loginCustomerId String?  @map("login_customer_id")
  name            String   @default("")
  currency        String   @default("USD")
  timezone        String   @default("UTC")
  isManager       Boolean  @default(false) @map("is_manager")
  isSelected      Boolean  @default(true) @map("is_selected")
  /// direct | mcc
  accessType      String   @default("direct") @map("access_type")
  lastError       String?  @map("last_error")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connection   AdConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([organizationId, customerId])
  @@index([connectionId])
  @@index([organizationId, isSelected])
  @@map("ad_google_ads_accounts")
}
model AdKeyword {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  adAccountId    String   @map("ad_account_id")
  adCampaignId   String   @map("ad_campaign_id")
  adSetId        String   @map("ad_set_id")
  externalId     String   @map("external_id")
  text           String
  matchType      String   @default("UNKNOWN") @map("match_type")
  status         String   @default("ENABLED")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  adAccount    AdAccount    @relation(fields: [adAccountId], references: [id], onDelete: Cascade)
  adCampaign   AdCampaign   @relation(fields: [adCampaignId], references: [id], onDelete: Cascade)
  adSet        AdSet        @relation(fields: [adSetId], references: [id], onDelete: Cascade)

  @@unique([organizationId, externalId])
  @@index([organizationId, adSetId])
  @@map("ad_keywords")
}
model AdSearchTermStat {
  id              String   @id @default(uuid())
  organizationId  String   @map("organization_id")
  adCampaignId    String   @map("ad_campaign_id")
  adSetId         String?  @map("ad_set_id")
  searchTerm      String   @map("search_term")
  date            DateTime @db.Date
  impressions     Int      @default(0)
  clicks          Int      @default(0)
  spend           Decimal  @default(0) @db.Decimal(18, 6)
  conversions     Decimal  @default(0) @db.Decimal(18, 6)
  conversionValue Decimal  @default(0) @map("conversion_value") @db.Decimal(18, 6)
  ctr             Decimal? @db.Decimal(18, 8)
  cpc             Decimal? @db.Decimal(18, 8)
  currency        String   @default("USD")
  createdAt       DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  adCampaign   AdCampaign   @relation(fields: [adCampaignId], references: [id], onDelete: Cascade)
  adSet        AdSet?       @relation(fields: [adSetId], references: [id], onDelete: SetNull)

  @@unique([adCampaignId, searchTerm, date])
  @@index([organizationId, date])
  @@map("ad_search_term_stats")
}
model GoogleAdsCampaignDraft {
  id               String                       @id @default(uuid())
  organizationId   String                       @map("organization_id")
  userId           String                       @map("user_id")
  customerId       String                       @map("customer_id")
  loginCustomerId  String?                      @map("login_customer_id")
  status           GoogleAdsCampaignDraftStatus @default(DRAFT)
  brief            Json
  structuredDraft  Json                         @map("structured_draft")
  validation       Json                         @default("{}")
  dailyBudget      Decimal                      @map("daily_budget") @db.Decimal(14, 2)
  monthlyEstimate  Decimal                      @map("monthly_estimate") @db.Decimal(14, 2)
  currency         String                       @default("VND")
  approvedAt       DateTime?                    @map("approved_at")
  approvedByUserId String?                      @map("approved_by_user_id")
