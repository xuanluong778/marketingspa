  /// Ngày theo timezone ad account
  date             DateTime @db.Date
  impressions      Int      @default(0)
  reach            Int      @default(0)
  clicks           Int      @default(0)
  spend            Decimal  @default(0) @db.Decimal(18, 6)
  conversions      Decimal  @default(0) @db.Decimal(18, 6)
  conversionValue  Decimal  @default(0) @map("conversion_value") @db.Decimal(18, 6)
  leads            Int      @default(0)
  ctr              Decimal? @db.Decimal(18, 8)
  cpc              Decimal? @db.Decimal(18, 8)
  cpm              Decimal? @db.Decimal(18, 8)
  cpa              Decimal? @db.Decimal(18, 8)
  roas             Decimal? @db.Decimal(18, 8)
  currency         String   @default("USD")
  timezone         String   @default("UTC")
