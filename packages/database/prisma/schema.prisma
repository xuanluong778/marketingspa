/// Spa / tenant
model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  phone     String?
  email     String?
  address   String?
  isActive  Boolean  @default(true) @map("is_active")
  /// Mã affiliate đã khóa lúc đăng ký (immutable)
  referredByCode         String?   @map("referred_by_code")
  referredByAffiliateId  String?   @map("referred_by_affiliate_id")
  referralLockedAt       DateTime? @map("referral_locked_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  branches          Branch[]
  users             User[]
  roles             Role[]
  employees         Employee[]
  departments       Department[]
  employmentContracts EmploymentContract[]
  employeeDocuments EmployeeDocument[]
  employeeAccountInvites EmployeeAccountInvite[]
  workShiftPolicies WorkShiftPolicy[]
  shiftAssignments  ShiftAssignment[]
  attendancePunches AttendancePunch[]
  attendanceDays    AttendanceDay[]
  timesheetPeriods  TimesheetPeriod[]
  attendanceAdjustments AttendanceAdjustment[]
  attendanceQrTokens AttendanceQrToken[]
  leaveRequests     LeaveRequest[]
  overtimeRequests  OvertimeRequest[]
  customers         Customer[]
  leads             Lead[]
  leadSources       LeadSource[]
  funnelStages      FunnelStage[]
  appointments      Appointment[]
  services          Service[]
  spaRooms          SpaRoom[]
  spaBeds           SpaBed[]
  spaEquipments     SpaEquipment[]
  crmTasks          CrmTask[]
  leadNotes         LeadNote[]
  leadActivities    LeadActivity[]
  leadSavedViews    LeadSavedView[]
  customerMergeLogs CustomerMergeLog[]
  messagingContactIdentities MessagingContactIdentity[]
  messagingIdentityMergeLogs MessagingIdentityMergeLog[]
  messagingChannelConnections MessagingChannelConnection[]
  messagingWebhookEvents MessagingWebhookEvent[]
  messagingCampaigns MessagingCampaign[]
  messagingCampaignRecipients MessagingCampaignRecipient[]
  messagingSuppressions MessagingSuppression[]
  messagingOrgPolicy MessagingOrgPolicy?
  leadAssignmentRules LeadAssignmentRule[]
  orders            Order[]
  payments          Payment[]
  expenses          Expense[]
  adAccounts        AdAccount[]
  adCampaigns       AdCampaign[]
  adDailyStats      AdDailyStat[]
  messageTemplates  MessageTemplate[]
  automationFlows   AutomationFlow[]
  automationLogs    AutomationLog[]
  aiReports         AiReport[]
  auditLogs         AuditLog[]
  authSessions      AuthSession[]
  subscriptions     Subscription[]
  paymentOrders     PaymentOrder[]
  creditWallet      CreditWallet?
  marketingCampaigns Campaign[]
  integrations      Integration[]
  businessGoalScenarios BusinessGoalScenario[]
  chatbotBots           ChatbotBot[]
  chatbotChannels       ChatbotChannel[]
  chatbotKnowledgeSources ChatbotKnowledgeSource[]
  chatbotConversations  ChatbotConversation[]
  chatbotLeads          ChatbotLead[]
  chatbotUsage          ChatbotUsage[]
  chatbotSettings       ChatbotOrgSettings?
  chatbotFacebookPages  ChatbotFacebookPage[]
  ragKnowledgeBases     RagKnowledgeBase[]
  leadAttributions      LeadAttribution[]
  marketingFunnelEvents MarketingFunnelEvent[]
  offlineConversionJobs OfflineConversionJob[]
  adSets                AdSet[]
  ads                   AdCreative[]
  facebookAdsConnection FacebookAdsConnection?
  adConnections         AdConnection[]
  adsSyncJobs           AdsSyncJob[]
  adsActionRequests     AdsActionRequest[]
  referredByAffiliate   AffiliateProfile? @relation("OrgReferredBy", fields: [referredByAffiliateId], references: [id], onDelete: SetNull)
  affiliateProfiles     AffiliateProfile[]
  affiliateReferralsAsReferred AffiliateReferral[] @relation("ReferralReferredOrg")
  trialClaim            TrialClaim?
  contentMarketingPreferences ContentMarketingPreference[]
  contentOpinionVoiceProfiles ContentOpinionVoiceProfile[]
  contentTeleprompterSources  ContentTeleprompterSource[]
  videoTranscriptions         VideoTranscription[]
  videoTranscriptionGlossaries VideoTranscriptionGlossary[]
  marketingAutopilotProjects  MarketingAutopilotProject[]
  marketingAutopilotAnalyses  MarketingAutopilotAnalysis[]
  marketingAutopilotDraftRuns MarketingAutopilotDraftRun[]
  marketingAutopilotDrafts    MarketingAutopilotDraft[]
  marketingMissions           MarketingMission[]
  marketingMissionAssets      MarketingMissionAsset[]
  marketingMissionApprovals   MarketingMissionApproval[]
  marketingAutopilotGuardrail MarketingAutopilotGuardrail?
  marketingAutopilotExecutionLogs MarketingAutopilotExecutionLog[]
  marketingAutopilotOutcomeLoops MarketingAutopilotOutcomeLoop[]
  marketingAutopilotOptimizationProposals MarketingAutopilotOptimizationProposal[]
  marketingAutopilotStopLossEvents MarketingAutopilotStopLossEvent[]
  marketingAutopilotOutcomeMutationLocks MarketingAutopilotOutcomeMutationLock[]
  marketingContextSnapshots   MarketingContextSnapshot[]
  marketingAutopilotOutcomeTracks MarketingAutopilotOutcomeTrack[]
  marketingAutopilotOutcomeEvaluations MarketingAutopilotOutcomeEvaluation[]
  marketingAutopilotBusinessLearnings MarketingAutopilotBusinessLearning[]
  marketingAutopilotFunnelSpecs MarketingAutopilotFunnelSpec[]
  marketingAutopilotEmailDrafts MarketingAutopilotEmailDraft[]
  marketingAutopilotScoringConfigs MarketingAutopilotScoringConfig[]

  @@index([referredByAffiliateId])
  @@index([referredByCode])
  @@map("organizations")
}

model Branch {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  code           String?
  address        String?
  phone          String?
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employees    Employee[]
  customers    Customer[]
  leads        Lead[]
  appointments Appointment[]
  orders       Order[]
  expenses     Expense[]
  businessGoalScenarios BusinessGoalScenario[]
  departments  Department[]
  workShiftPolicies WorkShiftPolicy[]
  shiftAssignments ShiftAssignment[]
  attendancePunches AttendancePunch[]
  attendanceDays AttendanceDay[]
  timesheetPeriods TimesheetPeriod[]
  attendanceQrTokens AttendanceQrToken[]
  leaveRequests LeaveRequest[]
  overtimeRequests OvertimeRequest[]
  spaRooms     SpaRoom[]
  spaBeds      SpaBed[]
  spaEquipments SpaEquipment[]
  leadAssignmentRules LeadAssignmentRule[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("branches")
}

model Permission {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  module      String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  roles RolePermission[]

  @@index([module])
  @@map("permissions")
}

model Role {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  code           String
  name           String
  description    String?
  isSystem       Boolean  @default(false) @map("is_system")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users        User[]
  permissions  RolePermission[]
  accountInvites EmployeeAccountInvite[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("roles")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

/// MVP: user gắn 1 organization; sau mở rộng qua OrganizationMember
model User {
  id             String   @id @default(uuid())
  email          String   @unique
  /// Email đã chuẩn hóa chống Gmail dot-trick (xuan.luong@gmail = xuanluong@gmail)
  emailNormalized String? @unique @map("email_normalized")
  /// Null khi đăng nhập chỉ bằng Google (chưa đặt mật khẩu)
  passwordHash   String?  @map("password_hash")
  name           String
  avatarUrl      String?  @map("avatar_url")
  /// Google subject (`sub`) — unique khi có
  googleSub      String?  @unique @map("google_sub")
  /// LOCAL | GOOGLE | BOTH
  authProvider   String   @default("LOCAL") @map("auth_provider")
  organizationId String   @map("organization_id")
  roleId         String   @map("role_id")
  employeeId     String?  @unique @map("employee_id")
  isActive       Boolean  @default(true) @map("is_active")
  /// Soft delete — giữ hóa đơn/audit/payment; user không đăng nhập được
  deletedAt      DateTime? @map("deleted_at")
  emailVerifiedAt DateTime? @map("email_verified_at")
  lastLoginAt    DateTime? @map("last_login_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  authSessions AuthSession[]
  authTokens   AuthToken[]
  role         Role         @relation(fields: [roleId], references: [id])
  employee     Employee?    @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  auditLogs    AuditLog[]
  trialClaim   TrialClaim?
  businessGoalScenarios BusinessGoalScenario[]
  adConnections         AdConnection[]
  adManagerSettings     AdManagerSettings?
  adAutomationRules     AdAutomationRule[]
  adAutomationLogs      AdAutomationLog[]
  adAiRecommendations   AdAiRecommendation[]
  adEmailReports        AdEmailReport[]
  adDrafts              AdDraft[]
  adInsights            AdInsight[]
  adPlatformAccounts    AdPlatformAccount[]
  adManagerCampaigns    AdManagerCampaign[]
  adsActionRequestsRequested AdsActionRequest[] @relation("AdsActionRequestedBy")
  adsActionRequestsApproved  AdsActionRequest[] @relation("AdsActionApprovedBy")
  facebookAdsConnectedOrgs FacebookAdsConnection[] @relation("FacebookAdsConnectedBy")
  autoPostFacebookConnections AutoPostFacebookConnection[]
  autoPostFacebookPages      AutoPostFacebookPage[]
  autoPosts                  AutoPost[]
  autoPostApiLogs            AutoPostApiLog[]
  autoPostPublishLogs        AutoPostPublishLog[]
  contentMarketingPreferences ContentMarketingPreference[]
  contentOpinionVoiceProfiles ContentOpinionVoiceProfile[]
  contentTeleprompterSources  ContentTeleprompterSource[]
  videoTranscriptions         VideoTranscription[]
  videoTranscriptionGlossaries VideoTranscriptionGlossary[]
  contractsCreated           EmploymentContract[] @relation("ContractCreatedBy")
  documentsUploaded          EmployeeDocument[]   @relation("DocumentUploadedBy")
  accountInvitesCreated      EmployeeAccountInvite[] @relation("AccountInviteCreatedBy")
  timesheetPeriodsLocked     TimesheetPeriod[]    @relation("TimesheetLockedBy")
  shiftPoliciesCreated       WorkShiftPolicy[]    @relation("ShiftPolicyCreatedBy")
  attendanceAdjustmentsCreated AttendanceAdjustment[] @relation("AttendanceAdjustmentBy")
  leaveApprovals             LeaveRequest[]       @relation("LeaveApprover")
  overtimeApprovals          OvertimeRequest[]    @relation("OvertimeApprover")
  messagingCampaignsCreated  MessagingCampaign[]
  leadSavedViews             LeadSavedView[]
  paymentOrders              PaymentOrder[]
  affiliateProfile           AffiliateProfile?
  marketingAutopilotProjects MarketingAutopilotProject[]
  archivedMarketingAutopilotProjects MarketingAutopilotProject[] @relation("MarketingAutopilotProjectArchivedBy")
  marketingAutopilotAnalyses MarketingAutopilotAnalysis[]
  marketingAutopilotDraftRuns MarketingAutopilotDraftRun[]
  marketingAutopilotDrafts    MarketingAutopilotDraft[]
  marketingMissions           MarketingMission[]
  marketingMissionApprovals   MarketingMissionApproval[]
  marketingAutopilotOptimizationProposals MarketingAutopilotOptimizationProposal[]
  marketingContextSnapshots   MarketingContextSnapshot[]
  marketingAutopilotOutcomeTracks MarketingAutopilotOutcomeTrack[]
  marketingAutopilotFunnelSpecs MarketingAutopilotFunnelSpec[]
  marketingAutopilotEmailDrafts MarketingAutopilotEmailDraft[]

  @@index([organizationId])
  @@index([roleId])
  @@index([deletedAt])
  @@map("users")
}

/// Idempotency cho thao tác admin (tặng thời gian, …) — chống double-submit
model AdminIdempotencyKey {
  id           String   @id @default(uuid())
  key          String   @unique
  action       String
  actorUserId  String   @map("actor_user_id")
  targetUserId String?  @map("target_user_id")
  responseJson Json     @map("response_json")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([action, targetUserId])
  @@map("admin_idempotency_keys")
}

model Employee {
  id              String         @id @default(uuid())
  organizationId  String         @map("organization_id")
  branchId        String?        @map("branch_id")
  departmentId    String?        @map("department_id")
  managerId       String?        @map("manager_id")
  code            String?
  name            String
  phone           String?
  email           String?
  position        String?
  employmentType  EmploymentType @default(FULL_TIME) @map("employment_type")
  status          EmployeeStatus @default(ACTIVE)
  avatarUrl       String?        @map("avatar_url")
  dateOfBirth     DateTime?      @map("date_of_birth")
  legalIdNumber   String?        @map("legal_id_number")
  address         String?
  startDate       DateTime?      @map("start_date")
  endDate         DateTime?      @map("end_date")
  isActive        Boolean        @default(true) @map("is_active")
  hiredAt         DateTime?      @map("hired_at")
  metadata        Json?
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch        Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  department    Department?   @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  manager       Employee?     @relation("EmployeeManager", fields: [managerId], references: [id], onDelete: SetNull)
  directReports Employee[]    @relation("EmployeeManager")
  user          User?
  assignedLeads Lead[]        @relation("LeadAssignee")
  claimedLeads  Lead[]        @relation("LeadClaimedBy")
  assignedCustomers Customer[] @relation("CustomerAssignee")
  appointments  Appointment[]
  crmTasks      CrmTask[]     @relation("TaskAssignee")
  contracts     EmploymentContract[]
  documents     EmployeeDocument[]
  accountInvites EmployeeAccountInvite[]
  shiftAssignments ShiftAssignment[]
  attendancePunches AttendancePunch[]
  attendanceDays AttendanceDay[]
  leaveRequests LeaveRequest[]
  overtimeRequests OvertimeRequest[]
  attendanceAdjustments AttendanceAdjustment[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([branchId])
  @@index([departmentId])
  @@index([organizationId, status])
  @@map("employees")
}

model Department {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  branchId       String?  @map("branch_id")
  parentId       String?  @map("parent_id")
  name           String
  code           String?
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  parent       Department?  @relation("DepartmentTree", fields: [parentId], references: [id], onDelete: SetNull)
  children     Department[] @relation("DepartmentTree")
  employees    Employee[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([branchId])
  @@map("departments")
}

model EmploymentContract {
  id                 String                   @id @default(uuid())
  organizationId     String                   @map("organization_id")
  branchId           String?                  @map("branch_id")
  employeeId         String                   @map("employee_id")
  code               String?
  title              String
