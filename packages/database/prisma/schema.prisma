/// Immutable approval snapshot — created once per version on "Duyệt & chạy".
model MarketingMissionApproval {
  id               String   @id @default(uuid())
  organizationId   String   @map("organization_id")
  missionId        String   @map("mission_id")
  projectId        String   @map("project_id")
  version          Int
  approvedById     String   @map("approved_by_id")
  approvedAt       DateTime @default(now()) @map("approved_at")
  /// Immutable payload: strategy, assets, budget, channels, version, approver, approvedAt
  snapshotJson     Json     @map("snapshot_json")
  runStatus        String   @default("APPROVED") @map("run_status") /// APPROVED | QUEUED | RUNNING | COMPLETED | FAILED
  startedAt        DateTime? @map("started_at")
  completedAt      DateTime? @map("completed_at")
  createdAt        DateTime @default(now()) @map("created_at")

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  mission      MarketingMission  @relation(fields: [missionId], references: [id], onDelete: Cascade)
  approvedBy   User             @relation(fields: [approvedById], references: [id], onDelete: Cascade)

  @@unique([missionId, version])
  @@index([organizationId, projectId, createdAt])
  @@index([organizationId, approvedAt])
  @@map("marketing_mission_approvals")
}

/// Per-organization guardrails for Autopilot Execution Engine.
