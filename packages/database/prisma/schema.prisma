// =============================================================================
// Marketing automation & messaging
// =============================================================================

enum MessageTemplateApprovalStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

model MessageTemplate {
  id                  String                         @id @default(uuid())
  organizationId      String                         @map("organization_id")
  name                String
  channel             MessageChannel
  subject             String?
  body                String
  variables           Json                           @default("[]")
  isActive            Boolean                        @default(true) @map("is_active")
  campaignKind        MessagingCampaignKind?         @map("campaign_kind")
  providerMode        String?                        @map("provider_mode")
  providerTemplateId  String?                        @map("provider_template_id")
  approvalStatus      MessageTemplateApprovalStatus  @default(DRAFT) @map("approval_status")
  mediaUrl            String?                        @map("media_url")
  ctaLabel            String?                        @map("cta_label")
  ctaUrl              String?                        @map("cta_url")
  /// Fallback khi thiếu biến: { "customer_name": "Quý khách" }
  variableFallbacks   Json                           @default("{}") @map("variable_fallbacks")
  contentBlocks       Json                           @default("[]") @map("content_blocks")
  createdAt           DateTime                       @default(now()) @map("created_at")
  updatedAt           DateTime                       @updatedAt @map("updated_at")

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  automationFlows AutomationFlow[]
  messagingCampaigns MessagingCampaign[]

  @@index([organizationId, channel])
  @@index([organizationId, approvalStatus])
  @@map("message_templates")
}

/// Chính sách chống spam theo organization
model MessagingOrgPolicy {
  id                            String   @id @default(uuid())
  organizationId                String   @unique @map("organization_id")
  timezone                      String   @default("Asia/Ho_Chi_Minh")
  quietHoursStart               String?  @map("quiet_hours_start") /// "HH:mm"
  quietHoursEnd                 String?  @map("quiet_hours_end")
  maxMessagesPerRecipientPerDay Int      @default(3) @map("max_messages_per_recipient_per_day")
  campaignCooldownMinutes       Int      @default(1440) @map("campaign_cooldown_minutes")
  /// { "MESSENGER": 20, "ZALO": 15 } — tin/giây theo channel
  channelRateLimits             Json     @default("{}") @map("channel_rate_limits")
  excludeRecentlyManualMessaged Boolean  @default(true) @map("exclude_recently_manual_messaged")
  manualMessageLookbackMinutes  Int      @default(60) @map("manual_message_lookback_minutes")
  stopOnReply                   Boolean  @default(true) @map("stop_on_reply")
  stopOnOptOut                  Boolean  @default(true) @map("stop_on_opt_out")
  createTaskOnReply             Boolean  @default(true) @map("create_task_on_reply")
  assignEmployeeOnReply         Boolean  @default(false) @map("assign_employee_on_reply")
  handoverToChatbotOnReply      Boolean  @default(true) @map("handover_to_chatbot_on_reply")
  /// Từ khóa opt-out: ["STOP","DỪNG","HUY","UNSUBSCRIBE"]
  optOutKeywords                Json     @default("[\"STOP\",\"DUNG\",\"HUY\",\"UNSUBSCRIBE\",\"OPT OUT\"]") @map("opt_out_keywords")
  createdAt                     DateTime @default(now()) @map("created_at")
  updatedAt                     DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("messaging_org_policies")
}

model AutomationFlow {
  id                String                @id @default(uuid())
  organizationId    String                @map("organization_id")
  messageTemplateId String?               @map("message_template_id")
  name              String
  triggerType       AutomationTriggerType @map("trigger_type")
  channel           MessageChannel?       @map("channel")
  delayMinutes      Int                   @default(0) @map("delay_minutes")
  triggerConfig     Json                  @default("{}") @map("trigger_config")
  /// Action graph: SEND_MESSAGE | SEND_EMAIL | CREATE_TASK | ASSIGN_EMPLOYEE | CHANGE_STATUS | ADD_TAG | CREATE_APPOINTMENT
  actions           Json                  @default("[]")
  isActive          Boolean               @default(true) @map("is_active")
  isPaused          Boolean               @default(false) @map("is_paused")
  quietHoursStart   String?               @map("quiet_hours_start") /// "HH:mm"
  quietHoursEnd     String?               @map("quiet_hours_end")
  maxSendsPerDay    Int?                  @map("max_sends_per_day")
  cooldownMinutes   Int                   @default(0) @map("cooldown_minutes")
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  messageTemplate MessageTemplate? @relation(fields: [messageTemplateId], references: [id], onDelete: SetNull)
  logs            AutomationLog[]

  @@index([organizationId, triggerType])
  @@map("automation_flows")
}

model AutomationLog {
  id               String              @id @default(uuid())
  organizationId   String              @map("organization_id")
  automationFlowId String              @map("automation_flow_id")
  customerId       String?             @map("customer_id")
  leadId           String?             @map("lead_id")
  appointmentId    String?             @map("appointment_id")
  channel          MessageChannel?     @map("channel")
  renderedContent  String?             @map("rendered_content")
  status           AutomationLogStatus @default(PENDING)
  result           Json?
  stepIndex        Int                 @default(0) @map("step_index")
  stepName         String?             @map("step_name")
  idempotencyKey   String?             @map("idempotency_key")
  executedAt       DateTime?           @map("executed_at")
  createdAt        DateTime            @default(now()) @map("created_at")

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  automationFlow AutomationFlow @relation(fields: [automationFlowId], references: [id], onDelete: Cascade)
  customer       Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  lead           Lead?          @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, createdAt])
  @@index([automationFlowId])
  @@map("automation_logs")
}

/// Marketing / messaging provider credentials (encrypted at rest)
model Integration {
  id                   String              @id @default(uuid())
  organizationId       String              @map("organization_id")
  provider             IntegrationProvider
  status               IntegrationStatus   @default(DISCONNECTED)
  encryptedCredentials String?             @map("encrypted_credentials")
  metadata             Json                @default("{}")
  lastTestedAt         DateTime?           @map("last_tested_at")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  messagingIdentities MessagingContactIdentity[]
  messagingCampaigns MessagingCampaign[]

  @@unique([organizationId, provider])
  @@index([organizationId])
  @@map("integrations")
}

// =============================================================================
// Multi-channel messaging identity (Messenger, Zalo OA, …)
// =============================================================================

/// Khách đã nhắn qua kênh tích hợp — không gộp tự động theo tên
model MessagingContactIdentity {
  id                     String                    @id @default(uuid())
  organizationId         String                    @map("organization_id")
  customerId             String?                   @map("customer_id")
  leadId                 String?                   @map("lead_id")
  channel                MessageChannel
  integrationId          String?                   @map("integration_id")
  /// Phạm vi unique: `integration:{id}` hoặc `{channel}:{accountRef}` (vd messenger_page:123)
  integrationScopeKey    String                    @map("integration_scope_key")
  externalUserId         String                    @map("external_user_id")
  externalConversationId String?                   @map("external_conversation_id")
  displayName            String?                   @map("display_name")
  avatarUrl              String?                   @map("avatar_url")
  phoneRaw               String?                   @map("phone_raw")
  phoneNormalized        String?                   @map("phone_normalized")
  phoneVerifiedAt        DateTime?                 @map("phone_verified_at")
  followStatus           MessagingFollowStatus     @default(UNKNOWN) @map("follow_status")
  consentStatus          MessagingConsentStatus    @default(UNKNOWN) @map("consent_status")
  isBlocked              Boolean                   @default(false) @map("is_blocked")
  optedOut               Boolean                   @default(false) @map("opted_out")
  linkSource             MessagingIdentityLinkSource @default(UNLINKED) @map("link_source")
  lastInboundAt          DateTime?                 @map("last_inbound_at")
  lastOutboundAt         DateTime?                 @map("last_outbound_at")
  mergedIntoId           String?                   @map("merged_into_id")
  chatbotConversationId  String?                   @map("chatbot_conversation_id")
  metadata               Json                      @default("{}")
  createdAt              DateTime                  @default(now()) @map("created_at")
  updatedAt              DateTime                  @updatedAt @map("updated_at")

  organization        Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer            Customer?                 @relation(fields: [customerId], references: [id], onDelete: SetNull)
  lead                Lead?                     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  integration         Integration?              @relation(fields: [integrationId], references: [id], onDelete: SetNull)
  mergedInto          MessagingContactIdentity? @relation("MessagingIdentityMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedFrom          MessagingContactIdentity[] @relation("MessagingIdentityMerge")
  chatbotConversation ChatbotConversation?      @relation(fields: [chatbotConversationId], references: [id], onDelete: SetNull)
  primaryMergeLogs    MessagingIdentityMergeLog[] @relation("PrimaryMergeIdentity")
  campaignRecipients  MessagingCampaignRecipient[]

  @@unique([organizationId, integrationScopeKey, externalUserId])
  @@unique([organizationId, integrationId, externalUserId])
  @@index([organizationId, channel])
  @@index([organizationId, customerId])
  @@index([organizationId, leadId])
  @@index([organizationId, phoneNormalized])
  @@index([organizationId, lastInboundAt])
  @@index([organizationId, consentStatus, optedOut])
  @@index([organizationId, followStatus])
  @@index([organizationId, mergedIntoId])
  @@index([organizationId, displayName])
  @@index([integrationId])
  @@index([chatbotConversationId])
  @@map("messaging_contact_identities")
}

/// Audit gộp identity thủ công — hỗ trợ hoàn tác
model MessagingIdentityMergeLog {
  id                String    @id @default(uuid())
  organizationId    String    @map("organization_id")
  primaryIdentityId String    @map("primary_identity_id")
  mergedIdentityIds String[]  @map("merged_identity_ids")
  mergedByUserId    String?   @map("merged_by_user_id")
  snapshot          Json
  undoneAt          DateTime? @map("undone_at")
  undoneByUserId    String?   @map("undone_by_user_id")
  createdAt         DateTime  @default(now()) @map("created_at")

  organization    Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  primaryIdentity MessagingContactIdentity @relation("PrimaryMergeIdentity", fields: [primaryIdentityId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([primaryIdentityId])
  @@map("messaging_identity_merge_logs")
}

// =============================================================================
// Multi-channel connections (Messenger pages, Zalo OA) — Prompt 4
// =============================================================================

enum MessagingChannelAccountStatus {
  DISCONNECTED
  ACTIVE
  EXPIRED
  REAUTH_REQUIRED
  ERROR
  PAUSED
}

enum MessagingProviderKind {
  MESSENGER
  ZALO_OA
  ZBS_TEMPLATE
}

/// Kết nối Fanpage / Zalo OA theo organization — hỗ trợ nhiều tài khoản mỗi kênh
model MessagingChannelConnection {
  id                   String                        @id @default(uuid())
  organizationId       String                        @map("organization_id")
  channel              MessageChannel
  providerKind         MessagingProviderKind         @map("provider_kind")
  accountRef           String                        @map("account_ref")
  displayName          String?                       @map("display_name")
  encryptedCredentials String?                       @map("encrypted_credentials")
  status               MessagingChannelAccountStatus @default(DISCONNECTED)
  permissions          Json                          @default("[]")
  tokenExpiresAt       DateTime?                     @map("token_expires_at")
  lastSyncedAt         DateTime?                     @map("last_synced_at")
  lastTestedAt         DateTime?                     @map("last_tested_at")
  webhookSubscribed    Boolean                       @default(false) @map("webhook_subscribed")
  isPaused             Boolean                       @default(false) @map("is_paused")
  metadata             Json                          @default("{}")
  createdAt            DateTime                      @default(now()) @map("created_at")
  updatedAt            DateTime                      @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  messagingCampaigns MessagingCampaign[]

  @@unique([organizationId, channel, accountRef])
  @@unique([channel, accountRef])
  @@index([organizationId, channel])
  @@index([organizationId, status])
  @@map("messaging_channel_connections")
}

/// Dedupe webhook events — chống replay/trùng
model MessagingWebhookEvent {
  id             String         @id @default(uuid())
  organizationId String         @map("organization_id")
  channel        MessageChannel
  eventKey       String         @map("event_key")
  receivedAt     DateTime       @default(now()) @map("received_at")
  processedAt    DateTime?      @map("processed_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([channel, eventKey])
  @@index([organizationId, receivedAt])
  @@map("messaging_webhook_events")
}

// =============================================================================
// Bulk messaging campaigns (Prompt 6)
// =============================================================================

enum MessagingCampaignStatus {
  DRAFT
  SCHEDULED
  PLANNING
  RUNNING
  PAUSED
  COMPLETED
  CANCELLED
  FAILED
}

enum MessagingCampaignKind {
  AUTOMATION
  BROADCAST
  TRANSACTIONAL
  TEMPLATE
}

enum MessagingCampaignRecipientStatus {
  PENDING
  QUEUED
  SENT
  DELIVERED
  READ
  REPLIED
  FAILED
  SKIPPED
  OPTED_OUT
}

enum MessagingSuppressionReason {
  BLOCKED
  OPTED_OUT
  MANUAL
  BOUNCE
}

model MessagingCampaign {
  id                   String                  @id @default(uuid())
  organizationId       String                  @map("organization_id")
  name                 String
  channel              MessageChannel
  campaignType         MessagingCampaignKind   @map("campaign_type")
  channelConnectionId  String?                 @map("channel_connection_id")
  integrationId        String?                 @map("integration_id")
  messageTemplateId    String?                 @map("message_template_id")
  status               MessagingCampaignStatus @default(DRAFT)
  segmentConfig        Json                    @default("{}") @map("segment_config")
  segmentSnapshot      Json?                   @map("segment_snapshot")
  variables            Json                    @default("{}")
  scheduledAt          DateTime?               @map("scheduled_at")
  timezone             String                  @default("Asia/Ho_Chi_Minh")
  totalRecipients      Int                     @default(0) @map("total_recipients")
  eligibleCount        Int                     @default(0) @map("eligible_count")
  excludedCount        Int                     @default(0) @map("excluded_count")
  queuedCount          Int                     @default(0) @map("queued_count")
  sentCount            Int                     @default(0) @map("sent_count")
  deliveredCount       Int                     @default(0) @map("delivered_count")
  readCount            Int                     @default(0) @map("read_count")
  repliedCount         Int                     @default(0) @map("replied_count")
  failedCount          Int                     @default(0) @map("failed_count")
  optOutCount          Int                     @default(0) @map("opt_out_count")
  estimatedCost        Decimal                 @default(0) @map("estimated_cost") @db.Decimal(14, 2)
  actualCost           Decimal                 @default(0) @map("actual_cost") @db.Decimal(14, 2)
  createdByUserId      String?                 @map("created_by_user_id")
  startedAt            DateTime?               @map("started_at")
  completedAt          DateTime?               @map("completed_at")
  cancelledAt          DateTime?               @map("cancelled_at")
  pausedAt             DateTime?               @map("paused_at")
  metadata             Json                    @default("{}")
  createdAt            DateTime                @default(now()) @map("created_at")
  updatedAt            DateTime                @updatedAt @map("updated_at")

  organization        Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  channelConnection   MessagingChannelConnection?  @relation(fields: [channelConnectionId], references: [id], onDelete: SetNull)
  integration         Integration?                 @relation(fields: [integrationId], references: [id], onDelete: SetNull)
  messageTemplate     MessageTemplate?             @relation(fields: [messageTemplateId], references: [id], onDelete: SetNull)
  createdBy           User?                        @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  recipients          MessagingCampaignRecipient[]

  @@index([organizationId, status])
  @@index([organizationId, channel])
  @@index([organizationId, scheduledAt])
  @@map("messaging_campaigns")
}

model MessagingCampaignRecipient {
  id                String                           @id @default(uuid())
  organizationId    String                           @map("organization_id")
  campaignId        String                           @map("campaign_id")
  identityId        String                           @map("identity_id")
  customerId        String?                          @map("customer_id")
  leadId            String?                          @map("lead_id")
  eligible          Boolean                          @default(false)
  exclusionReason   String?                          @map("exclusion_reason")
  providerMode      String?                          @map("provider_mode")
  renderedContent   String?                          @map("rendered_content") @db.Text
  idempotencyKey    String                           @map("idempotency_key")
  providerMessageId String?                          @map("provider_message_id")
  status            MessagingCampaignRecipientStatus @default(PENDING)
  attemptCount      Int                              @default(0) @map("attempt_count")
  lastError         String?                          @map("last_error")
  cost              Decimal                          @default(0) @db.Decimal(12, 2)
  queuedAt          DateTime?                        @map("queued_at")
  sentAt            DateTime?                        @map("sent_at")
  deliveredAt       DateTime?                        @map("delivered_at")
  readAt            DateTime?                        @map("read_at")
  repliedAt         DateTime?                        @map("replied_at")
  createdAt         DateTime                         @default(now()) @map("created_at")
  updatedAt         DateTime                         @updatedAt @map("updated_at")

  organization Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaign     MessagingCampaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  identity     MessagingContactIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)
  customer     Customer?                @relation(fields: [customerId], references: [id], onDelete: SetNull)
  lead         Lead?                    @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@unique([campaignId, idempotencyKey])
  @@index([organizationId, campaignId])
  @@index([campaignId, status])
  @@index([identityId])
  @@map("messaging_campaign_recipients")
}

model MessagingSuppression {
  id              String                    @id @default(uuid())
  organizationId  String                    @map("organization_id")
  channel         MessageChannel?
  identityId      String?                   @map("identity_id")
  phoneNormalized String?                   @map("phone_normalized")
  externalUserId  String?                   @map("external_user_id")
  channelAccountRef String?                 @map("channel_account_ref")
  reason          MessagingSuppressionReason
  note            String?
  createdByUserId String?                   @map("created_by_user_id")
  createdAt       DateTime                  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, channel])
  @@index([organizationId, phoneNormalized])
  @@index([organizationId, identityId])
  @@index([organizationId, externalUserId])
  @@map("messaging_suppressions")
}

/// Kết nối Facebook Ads metadata theo organization (token lưu ở AdConnection)
model FacebookAdsConnection {
  id                    String                      @id @default(uuid())
  organizationId        String                      @unique @map("organization_id")
  /// User thực hiện OAuth gần nhất (audit) — không dùng làm scope dữ liệu
  connectedByUserId     String                      @map("connected_by_user_id")
  selectedAdAccountId   String?                     @map("selected_ad_account_id")
  selectedAdAccountName String?                     @map("selected_ad_account_name")
  facebookUserId        String?                     @map("facebook_user_id")
  status                FacebookAdsConnectionStatus @default(DISCONNECTED)
  scopes                String[]                    @default([])
  lastSyncAt            DateTime?                   @map("last_sync_at")
  lastSyncStatus        FacebookAdsSyncStatus?      @map("last_sync_status")
  lastSyncError         String?                     @map("last_sync_error")
  createdAt             DateTime                    @default(now()) @map("created_at")
  updatedAt             DateTime                    @updatedAt @map("updated_at")

  organization      Organization                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connectedBy       User                          @relation("FacebookAdsConnectedBy", fields: [connectedByUserId], references: [id], onDelete: Cascade)
  syncLogs          FacebookAdsSyncLog[]
  campaignSnapshots FacebookAdsCampaignSnapshot[]

  @@index([connectedByUserId])
  @@map("facebook_ads_connections")
}

model FacebookAdsSyncLog {
  id              String                @id @default(uuid())
  organizationId  String                @map("organization_id")
  adAccountId     String                @map("ad_account_id")
  dateFrom        DateTime              @map("date_from") @db.Date
  dateTo          DateTime              @map("date_to") @db.Date
  syncStartedAt   DateTime              @map("sync_started_at")
  syncFinishedAt  DateTime?             @map("sync_finished_at")
  status          FacebookAdsSyncStatus
  errorMessage    String?               @map("error_message")
  campaignsSynced Int                   @default(0) @map("campaigns_synced")

  connection FacebookAdsConnection @relation(fields: [organizationId], references: [organizationId], onDelete: Cascade)

  @@index([organizationId, syncStartedAt])
  @@map("facebook_ads_sync_logs")
}

model FacebookAdsCampaignSnapshot {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  adAccountId    String   @map("ad_account_id")
  campaignId     String   @map("campaign_id")
  campaignName   String   @map("campaign_name")
  objective      String?
  campaignType   String   @map("campaign_type")
  dateFrom       DateTime @map("date_from") @db.Date
  dateTo         DateTime @map("date_to") @db.Date
  spend          Decimal  @default(0) @db.Decimal(14, 2)
  impressions    Int      @default(0)
  reach          Int      @default(0)
  frequency      Decimal  @default(0) @db.Decimal(10, 4)
  cpm            Decimal  @default(0) @db.Decimal(14, 4)
  cpc            Decimal  @default(0) @db.Decimal(14, 4)
  ctr            Decimal  @default(0) @db.Decimal(10, 4)
  clicks         Int      @default(0)
  results        Decimal  @default(0) @db.Decimal(14, 2)
  costPerResult  Decimal  @default(0) @map("cost_per_result") @db.Decimal(14, 4)
  purchaseRoas   Decimal? @map("purchase_roas") @db.Decimal(14, 4)
  resultRate     Decimal  @default(0) @map("result_rate") @db.Decimal(10, 4)
  syncedAt       DateTime @map("synced_at")

  connection FacebookAdsConnection @relation(fields: [organizationId], references: [organizationId], onDelete: Cascade)

  @@unique([organizationId, campaignId, dateFrom, dateTo])
  @@index([organizationId, adAccountId])
  @@map("facebook_ads_campaign_snapshots")
}

/// Marketing message campaign (queue worker) — tách biệt AdCampaign
model Campaign {
  id             String                  @id @default(uuid())
  organizationId String                  @map("organization_id")
  name           String
  status         MarketingCampaignStatus @default(DRAFT)
  channel        MessageChannel
  scheduledAt    DateTime?               @map("scheduled_at")
  sentCount      Int                     @default(0) @map("sent_count")
  createdAt      DateTime                @default(now()) @map("created_at")
  updatedAt      DateTime                @updatedAt @map("updated_at")

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customers    CampaignCustomer[]

  @@index([organizationId, status])
  @@map("campaigns")
}

model CampaignCustomer {
  campaignId String @map("campaign_id")
  customerId String @map("customer_id")

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@id([campaignId, customerId])
  @@map("campaign_customers")
}

// =============================================================================
// AI, audit, billing
// =============================================================================

model AiReport {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  type           String
  title          String
  content        Json
  generatedAt    DateTime @default(now()) @map("generated_at")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, type])
  @@map("ai_reports")
}

model AuditLog {
  id             String   @id @default(uuid())
  organizationId String?  @map("organization_id")
  userId         String?  @map("user_id")
  action         String
  entityType     String   @map("entity_type")
  entityId       String?  @map("entity_id")
  metadata       Json?
  ipAddress      String?  @map("ip_address")
  requestId      String?  @map("request_id")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
  @@index([requestId])
  @@map("audit_logs")
}

model AuthSession {
  id             String    @id @default(uuid())
  userId         String    @map("user_id")
  organizationId String    @map("organization_id")
  tokenHash      String    @unique @map("token_hash")
  userAgent      String?   @map("user_agent")
  ipAddress      String?   @map("ip_address")
  expiresAt      DateTime  @map("expires_at")
  revokedAt      DateTime? @map("revoked_at")
  lastUsedAt     DateTime? @map("last_used_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([organizationId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model AuthToken {
  id        String        @id @default(uuid())
  userId    String        @map("user_id")
  type      AuthTokenType
  tokenHash String        @unique @map("token_hash")
  expiresAt DateTime      @map("expires_at")
  usedAt    DateTime?     @map("used_at")
  createdAt DateTime      @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([expiresAt])
  @@map("auth_tokens")
}

model LoginAttempt {
  id        String   @id @default(uuid())
  email     String
  ipAddress String?  @map("ip_address")
  success   Boolean
  createdAt DateTime @default(now()) @map("created_at")

  @@index([email, createdAt])
  @@index([ipAddress, createdAt])
  @@map("login_attempts")
}

/// OTP đăng ký — chưa tạo User; chỉ lưu hash OTP + passwordHash
model RegistrationOtp {
  id                 String    @id @default(uuid())
  email              String
  codeHash           String    @map("code_hash")
  passwordHash       String    @map("password_hash")
  name               String
  organizationName   String    @map("organization_name")
  organizationSlug   String?   @map("organization_slug")
  /// Mã ref từ cookie lúc send-otp (server-side lock)
  referralCode       String?   @map("referral_code")
  expiresAt          DateTime  @map("expires_at")
  attemptCount       Int       @default(0) @map("attempt_count")
  maxAttempts        Int       @default(5) @map("max_attempts")
  consumedAt         DateTime? @map("consumed_at")
  invalidatedAt      DateTime? @map("invalidated_at")
  ipAddress          String?   @map("ip_address")
  createdAt          DateTime  @default(now()) @map("created_at")

  @@index([email, createdAt])
  @@index([expiresAt])
  @@map("registration_otps")
}

model SubscriptionPlan {
  id              String   @id @default(uuid())
  code            String   @unique
  name            String
  /// Giữ tương thích seed cũ (giá / tháng quy đổi)
  priceMonthly    Decimal  @map("price_monthly") @db.Decimal(12, 2)
  /// Giá thanh toán theo chu kỳ (VND)
  priceVnd        Decimal  @default(0) @map("price_vnd") @db.Decimal(14, 0)
  /// Số tháng gia hạn khi thanh toán
  durationMonths  Int      @default(1) @map("duration_months")
  highlightLabel  String?  @map("highlight_label")
  savingsAmount   Decimal? @map("savings_amount") @db.Decimal(14, 0)
  sortOrder       Int      @default(0) @map("sort_order")
  creditsIncluded Int      @default(0) @map("credits_included")
  features        Json     @default("[]")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")

  subscriptions Subscription[]
  paymentOrders PaymentOrder[]

  @@map("subscription_plans")
}

model Subscription {
  id                 String             @id @default(uuid())
  organizationId     String             @map("organization_id")
  planId             String             @map("plan_id")
  status             SubscriptionStatus @default(EXPIRED)
  currentPeriodStart DateTime           @map("current_period_start")
  currentPeriodEnd   DateTime           @map("current_period_end")
  /// Thời điểm user bấm kích hoạt dùng thử (không tính từ lúc đăng ký)
  trialStartedAt     DateTime?          @map("trial_started_at")
  trialEndsAt        DateTime?          @map("trial_ends_at")
  cancelledAt        DateTime?          @map("cancelled_at")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         SubscriptionPlan @relation(fields: [planId], references: [id])
  trialClaim   TrialClaim?

  @@index([organizationId, status])
  @@index([status, trialEndsAt])
  @@map("subscriptions")
}

/// Cấu hình dùng thử (singleton id=default)
model TrialSetting {
  id                      String   @id @default("default")
  enabled                 Boolean  @default(true)
  trialDays               Int      @default(3) @map("trial_days")
  /// Prefix API được phép khi TRIALING, VD: ["content-marketing","auto-post","video-transcriptions"]
  allowedFeaturePrefixes  Json     @default("[\"content-marketing\",\"auto-post\",\"video-transcriptions\"]") @map("allowed_feature_prefixes")
  aiDailyQuota            Int      @default(30) @map("ai_daily_quota")
  updatedAt               DateTime @updatedAt @map("updated_at")

  @@map("trial_settings")
}

/// Mỗi email/org/user/device chỉ được trial 1 lần (chống lạm dụng)
model TrialClaim {
  id                     String   @id @default(uuid())
  userId                 String   @unique @map("user_id")
  organizationId         String   @unique @map("organization_id")
  subscriptionId         String?  @unique @map("subscription_id")
  emailNormalized        String   @unique @map("email_normalized")
  phoneNormalized        String?  @map("phone_normalized")
  deviceFingerprintHash  String?  @map("device_fingerprint_hash")
  ipHash                 String?  @map("ip_hash")
  activatedAt            DateTime @map("activated_at")
  trialEndsAt            DateTime @map("trial_ends_at")
  createdAt              DateTime @default(now()) @map("created_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([phoneNormalized])
  @@index([deviceFingerprintHash])
  @@map("trial_claims")
}

/// Đơn thanh toán SaaS (SePay / VietQR)
model PaymentOrder {
  id              String            @id @default(uuid())
  code            String            @unique
  organizationId  String            @map("organization_id")
  planId          String            @map("plan_id")
  createdByUserId String?           @map("created_by_user_id")
  amountVnd       Decimal           @map("amount_vnd") @db.Decimal(14, 0)
  status          PaymentOrderStatus @default(PENDING)
  transferContent String            @map("transfer_content")
  bankCode        String            @map("bank_code")
  accountNumber   String            @map("account_number")
  accountName     String            @map("account_name")
  qrUrl           String?           @map("qr_url")
  expiresAt       DateTime          @map("expires_at")
  paidAt          DateTime?         @map("paid_at")
  cancelledAt     DateTime?         @map("cancelled_at")
  reviewNote      String?           @map("review_note")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         SubscriptionPlan @relation(fields: [planId], references: [id])
  createdBy    User?            @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  transactions PaymentTransaction[]

  @@index([organizationId, status])
  @@index([status, expiresAt])
  @@index([createdAt])
  @@map("payment_orders")
}

model PaymentTransaction {
  id                 String   @id @default(uuid())
  sepayTransactionId String   @unique @map("sepay_transaction_id")
  paymentOrderId     String?  @map("payment_order_id")
  organizationId     String?  @map("organization_id")
  amountVnd          Decimal  @map("amount_vnd") @db.Decimal(14, 0)
  accountNumber      String?  @map("account_number")
  gateway            String?
  content            String?
  transferType       String   @map("transfer_type")
  referenceCode      String?  @map("reference_code")
  rawPayload         Json     @map("raw_payload")
  /// HMAC | API_KEY — không lưu secret
  authMethod         String?  @map("auth_method")
  authVerified       Boolean  @default(false) @map("auth_verified")
  matched            Boolean  @default(false)
  matchedReason      String?  @map("matched_reason")
  processingError    String?  @map("processing_error") @db.Text
  processedAt        DateTime? @map("processed_at")
  createdAt          DateTime @default(now()) @map("created_at")

  paymentOrder PaymentOrder? @relation(fields: [paymentOrderId], references: [id], onDelete: SetNull)

  @@index([paymentOrderId])
  @@index([createdAt])
  @@index([matched, createdAt])
  @@map("payment_transactions")
}

model CreditWallet {
  id             String   @id @default(uuid())
  organizationId String   @unique @map("organization_id")
  balance        Decimal  @default(0) @db.Decimal(12, 2)
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  transactions CreditTransaction[]

  @@map("credit_wallets")
}

model CreditTransaction {
  id             String                @id @default(uuid())
  organizationId String                @map("organization_id")
  walletId       String                @map("wallet_id")
  type           CreditTransactionType
  amount         Decimal               @db.Decimal(12, 2)
