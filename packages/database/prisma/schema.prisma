model Lead {
  id               String             @id @default(uuid())
  organizationId   String             @map("organization_id")
  branchId         String?            @map("branch_id")
  leadSourceId     String?            @map("lead_source_id")
  /// Dynamic funnel pipeline (org-scoped)
  pipelineId       String?            @map("pipeline_id")
  /// Dynamic stage — DB column kept as funnel_stage_id for backward compatibility
  stageId          String?            @map("funnel_stage_id")
  assignedToId     String?            @map("assigned_to_id")
  customerId       String?            @map("customer_id")
  name             String
  phone            String?
  email            String?
  /// Legacy mirror of stage.legacyStatus / known codes — kept for reports & FSM
  pipelineStatus   LeadPipelineStatus @default(NEW) @map("pipeline_status")
  note             String?
  estimatedValue   Decimal?           @map("estimated_value") @db.Decimal(12, 2)
  lostReason       String?            @map("lost_reason")
  convertedAt      DateTime?          @map("converted_at")
  /// ID lead từ nền tảng ads (Meta leadgen_id, Google lead id…) — dedupe trong org
  platformExternalLeadId String?      @map("platform_external_lead_id")
  platform         AdPlatform?        @map("platform")
  score            Int                @default(0)
  /// MQL | SQL — set when score crosses funnel thresholds
  qualification    String?            @map("qualification")
  mqlReachedAt     DateTime?          @map("mql_reached_at")
  sqlReachedAt     DateTime?          @map("sql_reached_at")
  tags             String[]           @default([])
  slaRespondBy     DateTime?          @map("sla_respond_by")
  slaBreached      Boolean            @default(false) @map("sla_breached")
  lastContactedAt  DateTime?          @map("last_contacted_at")
  reminderAt       DateTime?          @map("reminder_at")
  /// Funnel draft/runtime that captured this lead (Prompt 8)
  funnelRecommendationId String?      @map("funnel_recommendation_id")
  /// Optimistic lock — chống 2 NV claim cùng lúc
  claimedById      String?            @map("claimed_by_id")
  claimedAt        DateTime?          @map("claimed_at")
  claimExpiresAt   DateTime?          @map("claim_expires_at")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch         Branch?         @relation(fields: [branchId], references: [id], onDelete: SetNull)
  leadSource     LeadSource?     @relation(fields: [leadSourceId], references: [id], onDelete: SetNull)
  pipeline       FunnelPipeline? @relation(fields: [pipelineId], references: [id], onDelete: SetNull)
  stage          FunnelStage?    @relation(fields: [stageId], references: [id], onDelete: SetNull)
  assignedTo     Employee?       @relation("LeadAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  claimedBy      Employee?       @relation("LeadClaimedBy", fields: [claimedById], references: [id], onDelete: SetNull)
  customer       Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  appointments   Appointment[]
  automationLogs AutomationLog[]
  attribution    LeadAttribution?
  funnelEvents   MarketingFunnelEvent[]
  orders         Order[]
  notes          LeadNote[]
  activities     LeadActivity[]
  crmTasks       CrmTask[]
  messagingIdentities MessagingContactIdentity[]
  campaignRecipients  MessagingCampaignRecipient[]
  funnelRecommendation FunnelRecommendation? @relation(fields: [funnelRecommendationId], references: [id], onDelete: SetNull)
  canvasRuntimeLogs FunnelRuntimeLog[]

  @@unique([organizationId, platformExternalLeadId])
  @@index([organizationId, pipelineStatus])
  @@index([organizationId, pipelineStatus, createdAt])
  @@index([organizationId, createdAt])
  @@index([organizationId, pipelineId, stageId])
  @@index([organizationId, phone])
  @@index([organizationId, email])
  @@index([organizationId, score])
  @@index([organizationId, qualification])
  @@index([organizationId, slaBreached, slaRespondBy])
  @@index([assignedToId])
  @@index([customerId])
  @@index([reminderAt])
  @@index([funnelRecommendationId])
  @@map("leads")
}

