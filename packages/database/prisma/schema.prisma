  checkStage       String   @map("check_stage") /// PERMISSION | INTEGRATION | APPROVAL | GUARDRAIL | EXECUTE
  result           String   /// PASSED | BLOCKED_* | EXECUTED | FAILED | SKIPPED
  message          String   @default("")
  beforeJson       Json     @default("{}") @map("before_json")
  afterJson        Json     @default("{}") @map("after_json")
  createdAt        DateTime @default(now()) @map("created_at")

