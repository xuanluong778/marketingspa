// =============================================================================
// Affiliate — referral 30% commission
// =============================================================================

model AffiliateProfile {
  id               String                 @id @default(uuid())
  userId           String                 @unique @map("user_id")
  organizationId   String                 @map("organization_id")
  code             String                 @unique
  status           AffiliateProfileStatus @default(ACTIVE)
  /// Null = dùng AffiliateSetting.defaultCommissionRate
  customRate       Decimal?               @map("custom_rate") @db.Decimal(5, 4)
  allowRenewalCommission Boolean          @default(false) @map("allow_renewal_commission")
  totalClicks      Int                    @default(0) @map("total_clicks")
  totalSignups     Int                    @default(0) @map("total_signups")
  totalPaidRefs    Int                    @default(0) @map("total_paid_refs")
  pendingAmount    Decimal                @default(0) @map("pending_amount") @db.Decimal(14, 0)
  availableAmount  Decimal                @default(0) @map("available_amount") @db.Decimal(14, 0)
  paidAmount       Decimal                @default(0) @map("paid_amount") @db.Decimal(14, 0)
  taxId            String?                @map("tax_id")
  taxName          String?                @map("tax_name")
  notes            String?                @db.Text
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")

  user             User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization     Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clicks           AffiliateClick[]
  referrals        AffiliateReferral[]
  commissions      AffiliateCommission[]
  payoutMethod     AffiliatePayoutMethod?
  payoutRequests   AffiliatePayoutRequest[]
  fraudSignals     AffiliateFraudSignal[]
  referredOrgs     Organization[]         @relation("OrgReferredBy")
  auditLogs        AffiliateAuditLog[]

  @@index([organizationId])
  @@index([status])
  @@map("affiliate_profiles")
}

model AffiliateClick {
  id             String   @id @default(uuid())
  affiliateId    String   @map("affiliate_id")
  code           String
  ipHash         String?  @map("ip_hash")
  userAgentHash  String?  @map("user_agent_hash")
  fingerprintHash String? @map("fingerprint_hash")
  landingPath    String?  @map("landing_path")
  createdAt      DateTime @default(now()) @map("created_at")

  affiliate AffiliateProfile @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  @@index([affiliateId, createdAt])
  @@index([code, createdAt])
  @@map("affiliate_clicks")
}

model AffiliateReferral {
  id                   String   @id @default(uuid())
  affiliateId          String   @map("affiliate_id")
  referredOrganizationId String @unique @map("referred_organization_id")
  referredUserId       String?  @map("referred_user_id")
  referralCode         String   @map("referral_code")
  /// Chỉ hoa hồng đơn đầu (mặc định true)
  firstOrderOnly       Boolean  @default(true) @map("first_order_only")
  status               String   @default("ACTIVE")
  registeredAt         DateTime @default(now()) @map("registered_at")
  firstPaidAt          DateTime? @map("first_paid_at")

  affiliate            AffiliateProfile @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  referredOrganization Organization     @relation("ReferralReferredOrg", fields: [referredOrganizationId], references: [id], onDelete: Cascade)
  commissions          AffiliateCommission[]

  @@index([affiliateId, registeredAt])
  @@map("affiliate_referrals")
}

model AffiliateCommission {
  id               String                     @id @default(uuid())
  affiliateId      String                     @map("affiliate_id")
  referralId       String                     @map("referral_id")
  /// Unique — idempotent theo đơn thanh toán
  orderId          String                     @unique @map("order_id")
  orderCode        String                     @map("order_code")
  sepayTransactionId String?                  @map("sepay_transaction_id")
  organizationId   String                     @map("organization_id")
  grossAmountVnd   Decimal                    @map("gross_amount_vnd") @db.Decimal(14, 0)
  /// Doanh thu thực thu dùng tính HH (không VAT/giảm giá/hoàn)
  netAmountVnd     Decimal                    @map("net_amount_vnd") @db.Decimal(14, 0)
  rate             Decimal                    @db.Decimal(5, 4)
  commissionVnd    Decimal                    @map("commission_vnd") @db.Decimal(14, 0)
  status           AffiliateCommissionStatus  @default(PENDING)
  isUpgrade        Boolean                    @default(false) @map("is_upgrade")
  isRenewal        Boolean                    @default(false) @map("is_renewal")
  holdUntil        DateTime                   @map("hold_until")
  availableAt      DateTime?                  @map("available_at")
  payoutRequestId  String?                    @map("payout_request_id")
  rejectReason     String?                    @map("reject_reason")
  reverseReason    String?                    @map("reverse_reason")
  metadata         Json                       @default("{}")
  createdAt        DateTime                   @default(now()) @map("created_at")
  updatedAt        DateTime                   @updatedAt @map("updated_at")

  affiliate     AffiliateProfile      @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  referral      AffiliateReferral     @relation(fields: [referralId], references: [id], onDelete: Cascade)
  payoutRequest AffiliatePayoutRequest? @relation(fields: [payoutRequestId], references: [id], onDelete: SetNull)

  @@index([affiliateId, status])
  @@index([status, holdUntil])
  @@index([organizationId])
  @@map("affiliate_commissions")
}

model AffiliatePayoutMethod {
  id             String   @id @default(uuid())
  affiliateId    String   @unique @map("affiliate_id")
  bankCode       String   @map("bank_code")
  bankName       String   @map("bank_name")
  /// Unique toàn hệ thống — 1 STK / 1 affiliate
  accountNumber  String   @unique @map("account_number")
  accountName    String   @map("account_name")
  branchName     String?  @map("branch_name")
  verifiedAt     DateTime? @map("verified_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  affiliate AffiliateProfile @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  @@map("affiliate_payout_methods")
}

model AffiliatePayoutRequest {
  id             String                @id @default(uuid())
  affiliateId    String                @map("affiliate_id")
  amountVnd      Decimal               @map("amount_vnd") @db.Decimal(14, 0)
  status         AffiliatePayoutStatus @default(PENDING)
  bankCode       String                @map("bank_code")
  bankName       String                @map("bank_name")
  accountNumber  String                @map("account_number")
  accountName    String                @map("account_name")
  taxId          String?               @map("tax_id")
  note           String?
  rejectReason   String?               @map("reject_reason")
  paidAt         DateTime?             @map("paid_at")
  paidReference  String?               @map("paid_reference")
  reviewedByUserId String?             @map("reviewed_by_user_id")
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")

  affiliate   AffiliateProfile       @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  commissions AffiliateCommission[]

  @@index([affiliateId, status])
  @@index([status, createdAt])
  @@map("affiliate_payout_requests")
}

model AffiliateFraudSignal {
  id             String                 @id @default(uuid())
  affiliateId    String?                @map("affiliate_id")
  organizationId String?                @map("organization_id")
  signalType     String                 @map("signal_type")
  severity       AffiliateFraudSeverity @default(MEDIUM)
  details        Json                   @default("{}")
  resolved       Boolean                @default(false)
  createdAt      DateTime               @default(now()) @map("created_at")

  affiliate AffiliateProfile? @relation(fields: [affiliateId], references: [id], onDelete: SetNull)

  @@index([affiliateId, createdAt])
  @@index([signalType, createdAt])
  @@map("affiliate_fraud_signals")
}

/// Singleton-ish settings (id = default)
model AffiliateSetting {
  id                       String   @id @default("default")
  defaultCommissionRate    Decimal  @default(0.30) @map("default_commission_rate") @db.Decimal(5, 4)
  holdDays                 Int      @default(14) @map("hold_days")
  minPayoutVnd             Decimal  @default(500000) @map("min_payout_vnd") @db.Decimal(14, 0)
  cookieDays               Int      @default(30) @map("cookie_days")
  firstOrderOnlyDefault    Boolean  @default(true) @map("first_order_only_default")
  allowRenewalCommission   Boolean  @default(false) @map("allow_renewal_commission")
  publicBaseUrl            String   @default("https://marketingautoaz.com") @map("public_base_url")
  updatedAt                DateTime @updatedAt @map("updated_at")

  @@map("affiliate_settings")
}

model AffiliateAuditLog {
  id             String   @id @default(uuid())
  affiliateId    String?  @map("affiliate_id")
  actorUserId    String?  @map("actor_user_id")
  action         String
  entityType     String   @map("entity_type")
  entityId       String?  @map("entity_id")
  reason         String?
  before         Json?
  after          Json?
  ipAddress      String?  @map("ip_address")
  createdAt      DateTime @default(now()) @map("created_at")

  affiliate AffiliateProfile? @relation(fields: [affiliateId], references: [id], onDelete: SetNull)

  @@index([affiliateId, createdAt])
  @@index([action, createdAt])
  @@map("affiliate_audit_logs")
}

// ─── Work management (Công việc & Dự án) ─────────────────────────────────────

model WorkProject {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  name           String    @db.VarChar(200)
  description    String?   @db.Text
  isArchived     Boolean   @default(false) @map("is_archived")
  createdById    String?   @map("created_by_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  columns      WorkBoardColumn[]
  tasks        WorkTask[]
  attachments  WorkAttachment[]

  @@index([organizationId, isArchived])
  @@map("work_projects")
}

model WorkBoardColumn {
  id         String   @id @default(uuid())
  projectId  String   @map("project_id")
  key        String   @db.VarChar(32)
  name       String   @db.VarChar(80)
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  project WorkProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   WorkTask[]

  @@unique([projectId, key])
  @@index([projectId, sortOrder])
  @@map("work_board_columns")
}

model WorkTask {
  id               String    @id @default(uuid())
  organizationId   String    @map("organization_id")
  projectId        String    @map("project_id")
  columnId         String    @map("column_id")
  title            String    @db.VarChar(300)
  description      String?   @db.Text
  /// Người giao việc
  assignerId       String?   @map("assigner_id")
  createdById      String?   @map("created_by_id")
  startDate        DateTime? @map("start_date") @db.Date
  deadline         DateTime? @db.Date
  /// LOW | MEDIUM | HIGH | URGENT
  priority         String    @default("MEDIUM") @db.VarChar(16)
  labels           String[]  @default([])
  progress         Int       @default(0)
  sortOrder        Int       @default(0) @map("sort_order")
  isArchived       Boolean   @default(false) @map("is_archived")
  deletedAt        DateTime? @map("deleted_at")
  copiedFromId     String?   @map("copied_from_id")
  /// Số lần bị yêu cầu sửa (REQUEST_FIX)
  revisionCount    Int       @default(0) @map("revision_count")
  lastSubmittedById String?  @map("last_submitted_by_id")
  lastSubmittedAt  DateTime? @map("last_submitted_at")
  lastReviewedById String?   @map("last_reviewed_by_id")
  lastReviewedAt   DateTime? @map("last_reviewed_at")
  lastReviewNote   String?   @map("last_review_note") @db.Text
  /// APPROVE | REQUEST_FIX
  lastReviewAction String?   @map("last_review_action") @db.VarChar(32)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      WorkProject          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  column       WorkBoardColumn      @relation(fields: [columnId], references: [id], onDelete: Restrict)
  assigner     Employee?            @relation("WorkTaskAssigner", fields: [assignerId], references: [id], onDelete: SetNull)
  createdBy    Employee?            @relation("WorkTaskCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  lastSubmittedBy Employee?         @relation("WorkTaskLastSubmitter", fields: [lastSubmittedById], references: [id], onDelete: SetNull)
  lastReviewedBy  Employee?         @relation("WorkTaskLastReviewer", fields: [lastReviewedById], references: [id], onDelete: SetNull)
  assignees    WorkTaskAssignee[]
  watchers     WorkTaskWatcher[]
  checklist    WorkChecklistItem[]
  comments     WorkTaskComment[]
  attachments  WorkAttachment[]
  statusHistory WorkTaskStatusHistory[]
  reviewEvents WorkTaskReviewEvent[]

  @@index([organizationId, projectId, deletedAt])
  @@index([projectId, columnId, sortOrder])
  @@index([organizationId, isArchived, deletedAt])
  @@index([assignerId])
  @@map("work_tasks")
}

model WorkTaskAssignee {
  taskId     String   @map("task_id")
  employeeId String   @map("employee_id")
  createdAt  DateTime @default(now()) @map("created_at")

  task     WorkTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@id([taskId, employeeId])
  @@index([employeeId])
  @@map("work_task_assignees")
}

model WorkTaskWatcher {
  taskId     String   @map("task_id")
  employeeId String   @map("employee_id")
  createdAt  DateTime @default(now()) @map("created_at")

  task     WorkTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@id([taskId, employeeId])
  @@index([employeeId])
  @@map("work_task_watchers")
}

model WorkChecklistItem {
  id        String   @id @default(uuid())
  taskId    String   @map("task_id")
  title     String   @db.VarChar(300)
  isDone    Boolean  @default(false) @map("is_done")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  task WorkTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, sortOrder])
  @@map("work_checklist_items")
}

/// Bình luận / trả lời trên công việc (@mention + emoji unicode trong body)
model WorkTaskComment {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  taskId         String    @map("task_id")
  parentId       String?   @map("parent_id")
  authorId       String    @map("author_id")
  body           String    @db.Text
  /// employeeIds được @mention
  mentionIds     String[]  @default([]) @map("mention_ids")
  editedAt       DateTime? @map("edited_at")
  deletedAt      DateTime? @map("deleted_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  task         WorkTask          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  parent       WorkTaskComment?  @relation("WorkCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies      WorkTaskComment[] @relation("WorkCommentReplies")
  author       Employee          @relation("WorkCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([organizationId, taskId, createdAt])
  @@index([parentId])
  @@index([authorId])
  @@map("work_task_comments")
}

/// File đính kèm task hoặc kho tài liệu dự án (không ghi đè — tên lưu uuid)
model WorkAttachment {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  projectId      String    @map("project_id")
  taskId         String?   @map("task_id")
  originalName   String    @map("original_name") @db.VarChar(500)
  storedName     String    @map("stored_name") @db.VarChar(80)
