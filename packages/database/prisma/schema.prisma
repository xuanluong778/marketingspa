  @@index([organizationId, projectId, createdAt])
  @@index([organizationId, missionId, createdAt])
  @@index([analysisId])
  @@index([draftRunId])
  @@index([draftId])
  @@index([missionId])
  @@index([recommendationId])
  @@map("marketing_autopilot_outcome_tracks")
}

/// Mission-scoped outcome loop: RUN → MONITOR → DIAGNOSE → RECOMMEND → OPTIMIZE → LEARN.
model MarketingAutopilotOutcomeLoop {
  id               String   @id @default(uuid())
  organizationId   String   @map("organization_id")
  missionId        String   @unique @map("mission_id")
  projectId        String   @map("project_id")
  currentStep      MarketingAutopilotOutcomeLoopStep @default(RUN) @map("current_step")
  status           String   @default("ACTIVE") /// ACTIVE | PAUSED_STOP_LOSS | COMPLETED
  autopilotMode    String   @default("APPROVAL_AUTOPILOT") @map("autopilot_mode")
  monitorJson      Json     @default("{}") @map("monitor_json") /// windows 1/7/30 metrics snapshots
  diagnosisJson    Json     @default("[]") @map("diagnosis_json")
  lastMonitorAt    DateTime? @map("last_monitor_at")
  lastDiagnoseAt   DateTime? @map("last_diagnose_at")
  lastRecommendAt  DateTime? @map("last_recommend_at")
  lastOptimizeAt   DateTime? @map("last_optimize_at")
  lastLearnAt      DateTime? @map("last_learn_at")
  stopLossActive   Boolean  @default(false) @map("stop_loss_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  mission      MarketingMission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@index([organizationId, currentStep, status])
  @@index([organizationId, projectId])
  @@map("marketing_autopilot_outcome_loops")
}

/// AI optimization proposal — APPROVAL_AUTOPILOT requires user approve before apply.
model MarketingAutopilotOptimizationProposal {
  id               String   @id @default(uuid())
  organizationId   String   @map("organization_id")
  missionId        String   @map("mission_id")
  projectId        String   @map("project_id")
  diagnosisKind    String   @map("diagnosis_kind") /// ADS_INEFFICIENT | FUNNEL_BOTTLENECK | ...
  title            String
  summary          String
  recommendationJson Json   @default("{}") @map("recommendation_json")
  metricsSnapshotJson Json @default("{}") @map("metrics_snapshot_json")
  status           MarketingAutopilotOptimizationStatus @default(PENDING_APPROVAL)
  correlationOnly  Boolean  @default(true) @map("correlation_only")
  approvedById     String?  @map("approved_by_id")
  approvedAt       DateTime? @map("approved_at")
  appliedAt        DateTime? @map("applied_at")
  blockedReason    String?  @map("blocked_reason")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  mission      MarketingMission @relation(fields: [missionId], references: [id], onDelete: Cascade)
  approvedBy   User? @relation(fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([organizationId, missionId, status])
  @@index([missionId, diagnosisKind])
  @@map("marketing_autopilot_optimization_proposals")
}

/// Stop-loss event — pause related assets, trigger diagnose → recommend.
model MarketingAutopilotStopLossEvent {
  id               String   @id @default(uuid())
  organizationId   String   @map("organization_id")
  missionId        String   @map("mission_id")
  reason           String   /// TRACKING_ERROR | SPEND_OVER_LIMIT | CPL_OVER | CPA_OVER
  triggerJson      Json     @default("{}") @map("trigger_json")
  pausedModules    Json     @default("[]") @map("paused_modules")
  resolvedAt       DateTime? @map("resolved_at")
  createdAt        DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  mission      MarketingMission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@index([organizationId, missionId, createdAt])
  @@map("marketing_autopilot_stop_loss_events")
}

/// Concurrency lock — one mutation per mission target at a time.
model MarketingAutopilotOutcomeMutationLock {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  lockKey        String   @map("lock_key")
  holder         String
  expiresAt      DateTime @map("expires_at")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, lockKey])
  @@index([expiresAt])
  @@map("marketing_autopilot_outcome_mutation_locks")
}

model MarketingAutopilotOutcomeEvaluation {
  id                 String   @id @default(uuid())
  organizationId     String   @map("organization_id")
  trackId            String   @map("track_id")
  horizonDays        Int      @map("horizon_days")
  dueAt              DateTime @map("due_at")
  evaluatedAt        DateTime? @map("evaluated_at")
  status             MarketingAutopilotOutcomeEvalStatus @default(PENDING)
  afterMetricsJson   Json     @default("{}") @map("after_metrics_json")
  afterSnapshotId    String?  @map("after_snapshot_id")
  outcomeJson        Json     @default("{}") @map("outcome_json")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  track        MarketingAutopilotOutcomeTrack @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([trackId, horizonDays])
  @@index([organizationId, status, dueAt])
  @@index([trackId, horizonDays])
  @@map("marketing_autopilot_outcome_evaluations")
}

/// Org-scoped business memory for Strategy Planner (correlation ≠ causation).
model MarketingAutopilotBusinessLearning {
  id               String   @id @default(uuid())
  organizationId   String   @map("organization_id")
  category         MarketingAutopilotLearningCategory
  key              String
  title            String
  summary          String
  evidenceJson     Json     @default("{}") @map("evidence_json")
  confidence       String   @default("LOW")
  sampleSize       Int      @default(1) @map("sample_size")
  correlationOnly  Boolean  @default(true) @map("correlation_only")
  sourceTrackIds   Json     @default("[]") @map("source_track_ids")
  isActive         Boolean  @default(true) @map("is_active")
  lastObservedAt   DateTime @default(now()) @map("last_observed_at")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, category, key])
  @@index([organizationId, isActive, category])
  @@index([organizationId, lastObservedAt])
  @@map("marketing_autopilot_business_learnings")
}

