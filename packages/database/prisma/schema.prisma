  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, createdAt])
  @@index([walletId])
  @@index([referenceId])
  @@index([featureCode])
  @@index([source])
  @@index([subscriptionId])
  @@map("credit_transactions")
}

