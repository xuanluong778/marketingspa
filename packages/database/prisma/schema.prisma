model Branch {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  code           String?
  address        String?
  phone          String?
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employees    Employee[]
  customers    Customer[]
  leads        Lead[]
  appointments Appointment[]
  orders       Order[]
  expenses     Expense[]
  businessGoalScenarios BusinessGoalScenario[]
  departments  Department[]
  workShiftPolicies WorkShiftPolicy[]
  shiftAssignments ShiftAssignment[]
  attendancePunches AttendancePunch[]
  attendanceDays AttendanceDay[]
  timesheetPeriods TimesheetPeriod[]
  attendanceQrTokens AttendanceQrToken[]
  leaveRequests LeaveRequest[]
  overtimeRequests OvertimeRequest[]
  spaRooms     SpaRoom[]
  spaBeds      SpaBed[]
  spaEquipments SpaEquipment[]
  leadAssignmentRules LeadAssignmentRule[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("branches")
}

model Permission {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  module      String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  roles RolePermission[]

  @@index([module])
  @@map("permissions")
}

model Role {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  code           String
  name           String
  description    String?
  isSystem       Boolean  @default(false) @map("is_system")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users        User[]
  permissions  RolePermission[]
  accountInvites EmployeeAccountInvite[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("roles")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

/// MVP: user gắn 1 organization; sau mở rộng qua OrganizationMember
model User {
  id             String   @id @default(uuid())
  email          String   @unique
  /// Email đã chuẩn hóa chống Gmail dot-trick (xuan.luong@gmail = xuanluong@gmail)
  emailNormalized String? @unique @map("email_normalized")
  /// Null khi đăng nhập chỉ bằng Google (chưa đặt mật khẩu)
  passwordHash   String?  @map("password_hash")
  name           String
  avatarUrl      String?  @map("avatar_url")
  /// Google subject (`sub`) — unique khi có
  googleSub      String?  @unique @map("google_sub")
  /// LOCAL | GOOGLE | BOTH
  authProvider   String   @default("LOCAL") @map("auth_provider")
  organizationId String   @map("organization_id")
  roleId         String   @map("role_id")
  employeeId     String?  @unique @map("employee_id")
  isActive       Boolean  @default(true) @map("is_active")
  /// Soft delete — giữ hóa đơn/audit/payment; user không đăng nhập được
  deletedAt      DateTime? @map("deleted_at")
  emailVerifiedAt DateTime? @map("email_verified_at")
  lastLoginAt    DateTime? @map("last_login_at")
  /// UI locale preference (vi | en)
  uiLocale       String   @default("vi") @map("ui_locale") @db.VarChar(8)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  authSessions AuthSession[]
  authTokens   AuthToken[]
  role         Role         @relation(fields: [roleId], references: [id])
  employee     Employee?    @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  auditLogs    AuditLog[]
  trialClaim   TrialClaim?
  businessGoalScenarios BusinessGoalScenario[]
  adConnections         AdConnection[]
  adManagerSettings     AdManagerSettings?
  adAutomationRules     AdAutomationRule[]
  adAutomationLogs      AdAutomationLog[]
  adAiRecommendations   AdAiRecommendation[]
  adEmailReports        AdEmailReport[]
  adDrafts              AdDraft[]
  adInsights            AdInsight[]
  adPlatformAccounts    AdPlatformAccount[]
  adManagerCampaigns    AdManagerCampaign[]
  adsActionRequestsRequested AdsActionRequest[] @relation("AdsActionRequestedBy")
  adsActionRequestsApproved  AdsActionRequest[] @relation("AdsActionApprovedBy")
  facebookAdsConnectedOrgs FacebookAdsConnection[] @relation("FacebookAdsConnectedBy")
  autoPostFacebookConnections AutoPostFacebookConnection[]
  autoPostFacebookPages      AutoPostFacebookPage[]
  autoPosts                  AutoPost[]
  autoPostApiLogs            AutoPostApiLog[]
  autoPostPublishLogs        AutoPostPublishLog[]
  contentMarketingPreferences ContentMarketingPreference[]
  contentOpinionVoiceProfiles ContentOpinionVoiceProfile[]
  contentTeleprompterSources  ContentTeleprompterSource[]
  videoTranscriptions         VideoTranscription[]
  videoTranscriptionGlossaries VideoTranscriptionGlossary[]
