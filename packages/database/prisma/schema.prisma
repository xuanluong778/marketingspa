  @@index([organizationId, missionId, createdAt])
  @@index([missionId, entityId])
  @@index([organizationId, result, createdAt])
  @@map("marketing_autopilot_execution_logs")
}

/// Registry of real domain assets created by AI Executor (linked by missionId).
