  diagnosisJson    Json     @default("[]") @map("diagnosis_json")
  lastMonitorAt    DateTime? @map("last_monitor_at")
  lastDiagnoseAt   DateTime? @map("last_diagnose_at")
  lastRecommendAt  DateTime? @map("last_recommend_at")
  lastOptimizeAt   DateTime? @map("last_optimize_at")
  lastLearnAt      DateTime? @map("last_learn_at")
