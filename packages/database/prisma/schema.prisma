  funnelEvents MarketingFunnelEvent[]
  appointments Appointment[]

  @@index([organizationId, status])
  @@index([adAccountId])
  @@index([organizationId, externalId])
  @@map("ad_campaigns")
}

model AdDailyStat {
  id               String   @id @default(uuid())
  organizationId   String   @map("organization_id")
