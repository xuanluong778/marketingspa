// =============================================================================
// CRM — Customer & Lead pipeline
// =============================================================================

model LeadSource {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  code           String?
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customers    Customer[]
  leads        Lead[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("lead_sources")
}

model FunnelStage {
  id             String              @id @default(uuid())
  organizationId String              @map("organization_id")
  name           String
  /// Maps to canonical LeadPipelineStatus for reporting/history
  code           LeadPipelineStatus? @map("code")
  position       Int                 @default(0)
  color          String?
  isDefault      Boolean             @default(false) @map("is_default")
  isActive       Boolean             @default(true) @map("is_active")
  isLostStage    Boolean             @default(false) @map("is_lost_stage")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leads        Lead[]

  @@unique([organizationId, name])
  @@index([organizationId, position])
  @@map("funnel_stages")
}

model Customer {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  branchId       String?   @map("branch_id")
  leadSourceId   String?   @map("lead_source_id")
  assignedEmployeeId String? @map("assigned_employee_id")
  name           String
  phone          String?
  email          String?
  gender         Gender    @default(UNKNOWN)
  birthday       DateTime? @db.Date
  note           String?
  tags           String[]  @default([])
  source         String? /// legacy/free-text source nếu chưa map LeadSource
  isActive       Boolean   @default(true) @map("is_active")
  mergedIntoId   String?   @map("merged_into_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch              Branch?              @relation(fields: [branchId], references: [id], onDelete: SetNull)
  leadSource          LeadSource?          @relation(fields: [leadSourceId], references: [id], onDelete: SetNull)
  assignedEmployee    Employee?            @relation("CustomerAssignee", fields: [assignedEmployeeId], references: [id], onDelete: SetNull)
  mergedInto          Customer?            @relation("CustomerMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedFrom          Customer[]           @relation("CustomerMerge")
  leads               Lead[]
  appointments        Appointment[]
  orders              Order[]
  automationLogs      AutomationLog[]
  marketingCampaigns  CampaignCustomer[]
  crmTasks            CrmTask[]
  messagingIdentities MessagingContactIdentity[]
  campaignRecipients  MessagingCampaignRecipient[]

  @@index([organizationId])
  @@index([organizationId, phone])
  @@index([branchId])
  @@index([assignedEmployeeId])
  @@map("customers")
}

model Lead {
  id               String             @id @default(uuid())
  organizationId   String             @map("organization_id")
  branchId         String?            @map("branch_id")
  leadSourceId     String?            @map("lead_source_id")
  funnelStageId    String?            @map("funnel_stage_id")
  assignedToId     String?            @map("assigned_to_id")
  customerId       String?            @map("customer_id")
  name             String
  phone            String?
  email            String?
  pipelineStatus   LeadPipelineStatus @default(NEW) @map("pipeline_status")
  note             String?
  estimatedValue   Decimal?           @map("estimated_value") @db.Decimal(12, 2)
  lostReason       String?            @map("lost_reason")
  convertedAt      DateTime?          @map("converted_at")
  /// ID lead từ nền tảng ads (Meta leadgen_id, Google lead id…) — dedupe trong org
  platformExternalLeadId String?      @map("platform_external_lead_id")
  platform         AdPlatform?        @map("platform")
  score            Int                @default(0)
  tags             String[]           @default([])
  slaRespondBy     DateTime?          @map("sla_respond_by")
  slaBreached      Boolean            @default(false) @map("sla_breached")
  lastContactedAt  DateTime?          @map("last_contacted_at")
  reminderAt       DateTime?          @map("reminder_at")
  /// Optimistic lock — chống 2 NV claim cùng lúc
  claimedById      String?            @map("claimed_by_id")
  claimedAt        DateTime?          @map("claimed_at")
  claimExpiresAt   DateTime?          @map("claim_expires_at")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch         Branch?         @relation(fields: [branchId], references: [id], onDelete: SetNull)
  leadSource     LeadSource?     @relation(fields: [leadSourceId], references: [id], onDelete: SetNull)
  funnelStage    FunnelStage?    @relation(fields: [funnelStageId], references: [id], onDelete: SetNull)
  assignedTo     Employee?       @relation("LeadAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  claimedBy      Employee?       @relation("LeadClaimedBy", fields: [claimedById], references: [id], onDelete: SetNull)
  customer       Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  appointments   Appointment[]
  automationLogs AutomationLog[]
  attribution    LeadAttribution?
  funnelEvents   MarketingFunnelEvent[]
  orders         Order[]
  notes          LeadNote[]
  activities     LeadActivity[]
  crmTasks       CrmTask[]
  messagingIdentities MessagingContactIdentity[]
  campaignRecipients  MessagingCampaignRecipient[]

  @@unique([organizationId, platformExternalLeadId])
  @@index([organizationId, pipelineStatus])
  @@index([organizationId, phone])
  @@index([organizationId, email])
  @@index([organizationId, score])
  @@index([assignedToId])
  @@index([customerId])
  @@index([reminderAt])
  @@map("leads")
}

// =============================================================================
// Operations — Appointment, Service, Order, Payment, Expense
// =============================================================================

model Service {
  id              String   @id @default(uuid())
  organizationId  String   @map("organization_id")
  name            String
  description     String?
  price           Decimal  @db.Decimal(12, 2)
  durationMinutes Int      @default(60) @map("duration_minutes")
  category        String?
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  appointments  Appointment[]
  orderItems    OrderItem[]

  @@index([organizationId])
  @@map("services")
}

model Appointment {
  id              String                   @id @default(uuid())
  organizationId  String                   @map("organization_id")
  branchId        String                   @map("branch_id")
  customerId      String?                  @map("customer_id")
  leadId          String?                  @map("lead_id")
  employeeId      String?                  @map("employee_id")
  serviceId       String?                  @map("service_id")
  roomId          String?                  @map("room_id")
  bedId           String?                  @map("bed_id")
  equipmentId     String?                  @map("equipment_id")
  adCampaignId    String?                  @map("ad_campaign_id")
  scheduledAt     DateTime                 @map("scheduled_at")
  durationMinutes Int                      @default(60) @map("duration_minutes")
  status          AppointmentStatus        @default(SCHEDULED)
  note            String?
  depositAmount   Decimal                  @default(0) @map("deposit_amount") @db.Decimal(12, 2)
  depositStatus   AppointmentDepositStatus @default(NONE) @map("deposit_status")
  checkedInAt     DateTime?                @map("checked_in_at")
  checkedOutAt    DateTime?                @map("checked_out_at")
  cancelledReason String?                  @map("cancelled_reason")
  noShowReason    String?                  @map("no_show_reason")
  rescheduledFromId String?                @map("rescheduled_from_id")
  createdAt       DateTime                 @default(now()) @map("created_at")
  updatedAt       DateTime                 @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  customer     Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  lead         Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  employee     Employee?    @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  service      Service?     @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  room         SpaRoom?     @relation(fields: [roomId], references: [id], onDelete: SetNull)
  bed          SpaBed?      @relation(fields: [bedId], references: [id], onDelete: SetNull)
  equipment    SpaEquipment? @relation(fields: [equipmentId], references: [id], onDelete: SetNull)
  adCampaign   AdCampaign?  @relation(fields: [adCampaignId], references: [id], onDelete: SetNull)
  rescheduledFrom Appointment?  @relation("AppointmentReschedule", fields: [rescheduledFromId], references: [id], onDelete: SetNull)
  rescheduledTo   Appointment[] @relation("AppointmentReschedule")

  @@index([organizationId, scheduledAt])
  @@index([branchId, status])
  @@index([employeeId, scheduledAt])
  @@index([roomId, scheduledAt])
  @@index([bedId, scheduledAt])
  @@index([adCampaignId])
  @@map("appointments")
}

model SpaRoom {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  branchId       String   @map("branch_id")
  name           String
  code           String?
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  beds         SpaBed[]
  appointments Appointment[]

  @@index([organizationId, branchId])
  @@map("spa_rooms")
