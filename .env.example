# =============================================================================
# MarketingSpa - Environment Variables (copy to .env and adjust)
# =============================================================================

# --- General ---
NODE_ENV=development
APP_NAME=MarketingSpa
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# --- SMTP (Gmail App Password khuyến nghị) — gửi OTP đăng ký ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="MarketingSpa <your@gmail.com>"
# true = cho phép log OTP ra server khi chưa có SMTP (chỉ dùng local/dev)
# AUTH_OTP_DEV_FALLBACK=false

# --- PostgreSQL ---
POSTGRES_USER=marketingspa
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=marketingspa
DATABASE_URL=postgresql://marketingspa:change_me_strong_password@localhost:5432/marketingspa?schema=public

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# --- JWT / Auth ---
JWT_SECRET=change_me_jwt_secret_min_32_chars_long
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# HRM Phase 0 — PermissionsGuard (false = shadow log only, không block)
HRM_PERMISSIONS_ENFORCE=true

# --- Credential encryption (integrations API keys) ---
ENCRYPTION_KEY=change_me_encryption_key_min_32_chars

# --- Meta / Facebook Ads + Auto Post Fanpage ---
META_APP_ID=
META_APP_SECRET=
# Bắt buộc với app Business (Facebook Login for Business, vd. app seoauto).
# Lấy tại Meta Dashboard → Facebook Login for Business → Configurations → Configuration ID
# (alias: FACEBOOK_LOGIN_CONFIG_ID / FACEBOOK_CONFIG_ID)
META_LOGIN_CONFIG_ID=
META_API_VERSION=v21.0
META_REDIRECT_URI=http://localhost:4000/api/v1/ad-performance/facebook/oauth/callback
# URI đã whitelist trên Meta (production: https://seoauto.vn/api/social/facebook/oauth/callback)
META_FACEBOOK_OAUTH_REDIRECT_URI=
# OAuth callback riêng cho Auto Post Fanpage (phải thêm vào Valid OAuth Redirect URIs)
META_AUTO_POST_REDIRECT_URI=http://localhost:4000/api/v1/auto-post/facebook/oauth/callback
# true = dùng META_REDIRECT_URI thay vì META_FACEBOOK_OAUTH_REDIRECT_URI / META_AUTO_POST_REDIRECT_URI
META_OAUTH_USE_SHARED_REDIRECT=false
# true chỉ khi META_LOGIN_CONFIG_ID là System User access token config
# META_LOGIN_OVERRIDE_DEFAULT_RESPONSE_TYPE=false
# Bật Facebook Login for Business OAuth cho Auto Post Fanpage
# - true: SaaS khách hàng tự kết nối Fanpage (không tự fallback SERVER_ENV)
# - false: chỉ dùng SERVER_ENV (META_PAGE_ID + META_PAGE_ACCESS_TOKEN) theo allowlist
OAUTH_CONNECTION=false
# Tuỳ chọn: ghi đè scope khi KHÔNG dùng META_LOGIN_CONFIG_ID
# META_AUTO_POST_SCOPES=pages_show_list,pages_manage_metadata,pages_read_engagement,pages_manage_posts

# --- Meta Ads bootstrap (optional — User token có ads_management; dùng khi chưa OAuth) ---
# META_ACCESS_TOKEN=
# META_AD_ACCOUNT_ID=act_1234567890

# --- Google Ads (OAuth server-side — không paste refresh token từ FE) ---
# Cùng GOOGLE_CLIENT_ID dùng cho Google Sign-In (Web client ID từ Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_API_VERSION=v18
GOOGLE_ADS_REDIRECT_URI=http://localhost:4000/api/v1/ad-performance/google/oauth/callback
# Optional: ADS_SYNC_TIMEOUT_MS=300000
# Optional: ADS_SYNC_MAX_ATTEMPTS=5

# --- Google Sign-In (ID token) ---
# Backend verify audience = GOOGLE_CLIENT_ID
# Frontend GIS button = NEXT_PUBLIC_GOOGLE_CLIENT_ID (thường cùng giá trị Web client ID)
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# --- Chatbot CSKH — Messenger (chỉ cần Page Access Token, không cần META_APP_ID) ---
# Callback URL: {API_URL}/api/v1/chatbot-cskh/facebook/webhook
CSKH_FB_WEBHOOK_VERIFY_TOKEN=marketingspa_cskh_fb
# Trong app: dán Page ID + Page Access Token (Messenger) là đủ

# --- Meta Fanpage đăng bài trực tiếp (token Page chỉ trên backend) ---
META_GRAPH_VERSION=v21.0
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
# Org UUID được phép POST /meta-fanpage/posts (SERVER_ENV). SUPER_ADMIN luôn được.
# META_FANPAGE_ALLOWED_ORG_IDS=org-uuid-1,org-uuid-2
META_FANPAGE_ALLOWED_ORG_IDS=

# --- Next.js (apps/web) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
# URL API công khai cho mã nhúng chatbot (HTTPS cùng domain website, vd. https://backlinkbrand.com/chatbot-api)
CHATBOT_PUBLIC_API_URL=https://backlinkbrand.com/chatbot-api
CHATBOT_PROXY_PATH=chatbot-api
NEXT_PUBLIC_WS_URL=ws://localhost:4000

# --- Sentry (placeholder - configure in production) ---
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# --- BullMQ / Worker ---
QUEUE_PREFIX=marketingspa

# --- AI Service (placeholder) ---
AI_SERVICE_URL=http://localhost:8000

# --- OpenAI (chatbot CSKH + gợi ý AI) ---
# Lấy key tại https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Tùy chọn: proxy/Azure (vd. https://api.openai.com/v1)
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Nginx / SSL (production VPS) ---
DOMAIN=your-domain.com
SSL_EMAIL=admin@your-domain.com

# --- Backup ---
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=7

# --- SePay / VietQR thanh toán SaaS ---
SEPAY_API_TOKEN=
SEPAY_WEBHOOK_SECRET=
PAYMENT_BANK_CODE=ACB
PAYMENT_ACCOUNT_NUMBER=7982468
PAYMENT_ACCOUNT_NAME=CONG TY TNHH THE GIOI DIGI
PAYMENT_CODE_PREFIX=MKTA
# APP_URL đã khai báo ở trên — production: https://marketingautoaz.com

# --- Platform SUPER_ADMIN (chỉ dùng khi bootstrap gán role; runtime check role) ---
PLATFORM_SUPER_ADMIN_EMAIL=xuanluong778@gmail.com

# --- Messaging live send ---
# true = gửi thật mọi Page; false = chỉ dry-run trừ Page trong MESSAGING_LIVE_PAGE_IDS
MESSAGING_LIVE_SEND=false
# Comma-separated Meta Page IDs được phép gửi live khi MESSAGING_LIVE_SEND=false
MESSAGING_LIVE_PAGE_IDS=

# --- Ads action requests (approve → worker). false = tắt toàn bộ write action ---
ADS_ACTIONS_LIVE=false
# Provider write API (Meta/Google) — chưa bật trong phase này
ADS_ACTIONS_PROVIDER_WRITE=false

# --- Worker ---
STALE_LEAD_MINUTES=10
