# Web app - see root .env.example
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000
# Google Identity Services — Web client ID (cùng GOOGLE_CLIENT_ID trên API)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_SENTRY_DSN=

# Teleprompter Background Effects
# Explicit false/0/off disables blur UI. Unset = enabled in browser only.
# TELEPROMPTER_BACKGROUND_EFFECTS=true
# NEXT_PUBLIC_TELEPROMPTER_BACKGROUND_EFFECTS=true
